{
    "name": "bybrooklyn-dev",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "bun scripts/photos.ts && astro dev",
        "build": "bun scripts/photos.ts && astro build",
        "preview": "astro preview",
        "check": "astro check",
        "deploy": "astro check && bun run build && wrangler pages deploy",
        "deploy:preview": "astro check && bun run build && wrangler pages deploy --branch preview",
        "deploy:drafts": "astro check && bun scripts/photos.ts && SHOW_DRAFTS=1 astro build --outDir .drafts-build && wrangler pages deploy .drafts-build --branch drafts",
        "cf:login": "wrangler login",
        "cf:whoami": "wrangler whoami",
        "langs": "bun scripts/languages.ts",
        "projects": "bun scripts/projects.ts",
        "edit": "bun scripts/write.ts",
        "photos": "bun scripts/photos.ts"
    },
    "dependencies": {
        "@astrojs/check": "0.9.12",
        "@astrojs/markdown-satteri": "^0.4.3",
        "@astrojs/mdx": "^8.1.3",
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.4",
        "astro": "7.4.8",
        "sharp": "0.35.5",
        "typescript": "6"
    },
    "devDependencies": {
        "@huggingface/transformers": "^4.3.2",
        "@types/bun": "^1.4.4",
        "simple-icons": "^16.37.0",
        "wrangler": "4.160.0"
    },
    "license": "MIT"
}
