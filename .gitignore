.DS_Store
.idea
node_modules
dist
.astro
/.playwright-mcp
/.claude

# wrangler local state and secrets
.wrangler
.dev.vars
.dev.vars.*

# secrets and keys of any kind: never committed, whatever adds files (the editor's Publish stages everything)
password.md
.env
.env.*
*.pem
*.key

# resume PDFs of drafts, and the build they are printed from
resume-preview
.resume-build

# the whole site with drafts shown, for the drafts preview only
.drafts-build

# pictures waiting to go on the photos page, and the originals of those that have:
# they carry location and camera details, so they stay on this computer
/photos

# posts being held back: written here, shown on the dev server, never committed.
# To publish one, take ".hold" out of its file name.
src/content/blog/*.hold.mdx

# what cargo builds of the walking mini's engine; the module itself is copied to public/wasm
walker/target/

# a file the editor is part way through saving (written beside the real one, then moved over it)
*.saving

# the sand engine's build folder
sand/target/
