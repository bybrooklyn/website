---
// A last name that is not in the page until someone asks for it.
//
// On the site it is a blurred stand-in; hovering sharpens it a little and
// clicking swaps in the real name and brings it into focus. The name is
// carried scrambled in an attribute so it never appears as text in the HTML.
// When the resume is printed to PDF (PRINT_NAME=1, set by
// scripts/resume-pdf.ts) the name is written plainly, since that goes to
// employers.
//
// The name itself lives in src/data/private.ts, which is not in the public
// repository. If that file is missing, this renders nothing.
const found = import.meta.glob<{ lastName: string }>("../data/private.ts", { eager: true });
const lastName = Object.values(found)[0]?.lastName;

const plain = process.env.PRINT_NAME === "1";
// Reversed, then base64: enough to keep it out of page text and search results.
const scrambled = lastName && Buffer.from([...lastName].reverse().join("")).toString("base64");
const standIn = lastName && "Lastname".slice(0, lastName.length).padEnd(lastName.length, "e");
---

{
    lastName &&
        (plain ? (
            <span>{lastName}</span>
        ) : (
            <button class="last-name" type="button" data-name={scrambled} aria-label="Show last name">
                <span aria-hidden="true">{standIn}</span>
            </button>
        ))
}

<script>
    for (const button of document.querySelectorAll<HTMLButtonElement>("button.last-name")) {
        button.addEventListener("click", () => {
            // Put the real name in place while it is still blurred, then let it sharpen.
            const shown = document.createElement("span");
            shown.className = "last-name";
            shown.textContent = [...atob(button.dataset.name ?? "")].reverse().join("");
            // Keep the keyboard where it was, so the name is read out and focus is not lost.
            shown.tabIndex = -1;
            button.replaceWith(shown);
            shown.focus({ preventScroll: true });
            requestAnimationFrame(() => requestAnimationFrame(() => shown.classList.add("shown")));
        });
    }
</script>

