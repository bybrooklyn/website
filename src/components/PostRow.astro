---
import Picture from "./Picture.astro";
import "../styles/blog.css";
import { accents } from "../data/theme";
import { css } from "../lib/color";
import { formatDate, readingTime, type Post } from "../lib/posts";

interface Props {
    post: Post;
    /** Heading level, so the row fits the outline of the page it is on. */
    level?: 2 | 3;
    /** A shorter row for the homepage: title, date and summary only. */
    compact?: boolean;
}

const { post, level = 2, compact = false } = Astro.props;
const Heading = `h${level}` as const;
const { title, summary, date, draft, cover, tags, accent } = post.data;
---

{
    compact ? (
        <li class="post-row compact">
            <a href={`/blog/${post.id}/`}>
                <div class="post-row-head">
                    <Heading>{title}</Heading>
                    <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
                </div>
                <p>
                    {summary}
                    {draft && <span class="post-draft"> Draft.</span>}
                </p>
            </a>
        </li>
    ) : (
        <li class="post-row" style={accent && `--accent:${css(accents[accent])}`}>
            <a href={`/blog/${post.id}/`}>
                {cover ? (
                    <Picture class="post-thumb" src={cover} alt="" width={448} height={280} fit="cover" />
                ) : (
                    // No cover: the title's first letter stands in, so every row has the same shape.
                    <span class="post-thumb post-letter" aria-hidden="true">{title.trim().charAt(0)}</span>
                )}
                <div>
                    <Heading>{title}</Heading>
                    <p>{summary}</p>
                    <p class="post-meta">
                        <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
                        <span>{readingTime(post)}</span>
                        {tags.map((tag) => (
                            <span>{tag}</span>
                        ))}
                        {draft && <span>draft</span>}
                    </p>
                </div>
            </a>
        </li>
    )
}
