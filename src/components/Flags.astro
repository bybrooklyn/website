---
// The two small flags beside the site name. Rest on one for a moment and it
// says what it is.
---

<span class="flags">
    <span class="flag trans" role="img" aria-label="Trans pride flag" tabindex="0">
        <span class="tip" aria-hidden="true">Trans pride flag</span>
    </span>
    <span class="flag lesbian" role="img" aria-label="Lesbian pride flag" tabindex="0">
        <span class="tip" aria-hidden="true">Lesbian pride flag</span>
    </span>
</span>
