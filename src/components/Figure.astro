---
interface Props {
    src: string;
    alt: string;
    width: number;
    height: number;
    caption?: string;
    /** Wrap the image in a link. */
    href?: string;
    /** A short silent clip to play in place of the image, which becomes its poster. */
    video?: string;
    /** Pixel art: scale without smoothing. */
    pixel?: boolean;
    /** Above the fold: load first. */
    eager?: boolean;
}

const { src, alt, width, height, caption, href, video, pixel = false, eager = false } = Astro.props;
const loading = eager ? "eager" : "lazy";
const fetchpriority = eager ? "high" : undefined;
---

<figure class:list={["figure", { pixel }]}>
    {
        video ? (
            <video
                src={video}
                poster={src}
                {width}
                {height}
                aria-label={alt}
                muted
                loop
                playsinline
                preload="none"
                data-clip
            />
        ) : href ? (
            <a {href}>
                <img {src} {alt} {width} {height} {loading} {fetchpriority} decoding="async" />
            </a>
        ) : (
            <img {src} {alt} {width} {height} {loading} {fetchpriority} decoding="async" />
        )
    }
    {caption && <figcaption class="note">{caption}</figcaption>}
</figure>

<script>
    // A clip loads and plays only once on screen. With reduced motion, reduced
    // data or a slow connection it stays a poster with controls.
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    const sparing =
        matchMedia("(prefers-reduced-motion: reduce)").matches ||
        matchMedia("(prefers-reduced-data: reduce)").matches ||
        Boolean(connection?.saveData) ||
        /2g|3g/.test(connection?.effectiveType ?? "");
    const clips = document.querySelectorAll<HTMLVideoElement>("video[data-clip]");
    if (sparing) {
        for (const clip of clips) clip.controls = true;
    } else {
        const watcher = new IntersectionObserver((entries) => {
            for (const { target, isIntersecting } of entries) {
                const clip = target as HTMLVideoElement;
                if (isIntersecting) void clip.play().catch(() => (clip.controls = true));
                else clip.pause();
            }
        });
        for (const clip of clips) watcher.observe(clip);
    }
</script>
