---
import { site } from "../data/site";
import { build } from "../lib/build";
import { hasPosts } from "../lib/posts";

const posts = await hasPosts();
const rights = "Some rights reserved. All page content is under CC BY-NC.";
---

<footer class="site-footer">
    <ul>
        <li>
            <a class="reveal" href={`mailto:${site.email}`}>
                <span class="reveal-short">email</span>
                <span class="reveal-full" aria-hidden="true">{site.email}</span>
            </a>
        </li>
        <li><a href={site.github} rel="me">github</a></li>
        <li><a href={site.discord} rel="me">discord</a></li>
        {posts && (
            <li>
                <a href="/rss.xml">rss</a>
            </li>
        )}
        <li><a href={site.source}>source</a></li>
        <li class="rights-item">
            <a class="reveal rights" href="/license/" rel="license" aria-label={rights}>
                <span class="reveal-short" aria-hidden="true">copyright</span>
                <span class="reveal-full" aria-hidden="true">{rights}</span>
            </a>
        </li>
    </ul>
    <p class="note">
        built <time datetime={build.iso}>{build.time}</time>{build.commit && <> from <a class="commit" href={`${site.source}/commit/${build.commit}`}><code>{build.commit}</code></a></>}
    </p>
</footer>

<script>
    // Measure both texts of a revealing link so its width can ease between them.
    function measure() {
        for (const link of document.querySelectorAll<HTMLElement>(".reveal")) {
            const short = link.querySelector<HTMLElement>(".reveal-short");
            const full = link.querySelector<HTMLElement>(".reveal-full");
            if (!short || !full) continue;
            link.classList.remove("ready");
            full.style.display = "inline";
            link.style.setProperty("--short", `${short.getBoundingClientRect().width}px`);
            link.style.setProperty("--full", `${full.getBoundingClientRect().width}px`);
            full.style.display = "";
            link.classList.add("ready");
            // Where widening would move the link itself (its line wraps, or the footer does), it would slip out
            // from under the pointer, shrink again, and so on for ever. There it stays the short word.
            // (tried at once, not eased, or it would be measured before it had widened)
            // The same if the page would grow taller: at its foot that slides everything up under a pointer held still.
            const place = () => ({ top: link.getBoundingClientRect().top, left: link.getBoundingClientRect().left, tall: document.documentElement.scrollHeight });
            const before = place();
            link.style.transition = "none";
            link.style.width = "var(--full)";
            const after = place();
            link.style.width = "";
            void link.offsetWidth;
            link.style.transition = "";
            link.classList.toggle("ready", Math.abs(after.top - before.top) < 1 && Math.abs(after.left - before.left) < 1 && after.tall === before.tall);
        }
    }
    measure();
    addEventListener("resize", measure);
    // The widths change once the real typeface has arrived.
    document.fonts.ready.then(measure);
</script>
