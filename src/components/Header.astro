---
import Flags from "./Flags.astro";
import { nav, site } from "../data/site";
import { getCollection } from "astro:content";
import { visible } from "../lib/drafts";
import { photos } from "../lib/photos";
import { hasPosts } from "../lib/posts";
import { getResume } from "../lib/resume";

const here = Astro.url.pathname;
// Links to pages that are not built are left out.
const hasResume = (await getResume()) !== undefined;
const hasAbout = (await getCollection("pages", (page) => page.id === "about" && visible(page))).length > 0;
const posts = await hasPosts();
const hidden = new Set([
    ...(hasResume ? [] : ["/resume/"]),
    ...(hasAbout ? [] : ["/about/"]),
    ...(posts ? [] : ["/blog/"]),
    ...(photos.length > 0 ? [] : ["/photos/"]),
]);
const links = nav.filter((item) => !hidden.has(item.href));
---

<header class="site-header">
    <div class="site-id">
        <a class="site-name" href="/">{site.name.toLowerCase()}</a>
        <Flags />
    </div>
    <nav aria-label="Site">
        <ul>
            {
                links.map((item) => (
                    <li>
                        <a href={item.href} aria-current={here.startsWith(item.href) ? "page" : undefined}>
                            {item.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>
</header>
