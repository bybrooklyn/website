---
// A cover drawn from the project itself: its name, on a ground tinted with
// its main language's color, under a pattern of squares that is worked out
// from the letters of the name, so each project gets its own and always the
// same one. Given what the repository is written in, each square is the color
// of one of its languages, as many of each as its share of the code.
import { languageColors, otherLanguageColor } from "../data/theme";
import { css } from "../lib/color";
import { cells, nameSize } from "../lib/drawn";

interface Props {
    name: string;
    language: string;
    /** The languages of its repository and each one's share, largest first. */
    languages?: [name: string, share: number][];
    class?: string;
}

const { name, language, languages = [], class: className } = Astro.props;
const color = (one: string) => css((languageColors as Record<string, [number, number, number]>)[one] ?? otherLanguageColor);
const tint = color(languages[0]?.[0] ?? language);

const size = nameSize(name);
---

<svg class:list={["drawn-cover", className]} viewBox="0 0 320 200" role="img" aria-label={`${name}: a ${language} project.`} style={`--tint:${tint}`}>
    <rect class="drawn-ground" width="320" height="200"></rect>
    {cells(name, languages).map((cell) => <rect class="drawn-cell" x={cell.x} y={cell.y} width="12" height="12" rx="2.5" opacity={(cell.language ? 0.45 + cell.strength * 0.55 : cell.strength).toFixed(2)} style={cell.language && `fill:${color(cell.language)}`} />)}
    <text class="drawn-name" x="17" y="180" font-size={size.toFixed(1)}>{name}</text>
</svg>
