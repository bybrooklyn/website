---
// What sits beside a post or long page: its table of contents, then, for a
// post, its sources and how to cite it. In the margin on a wide screen, where
// it stays in view and marks the section being read. On a narrow one the
// contents fold away above the text and the rest goes to the end.
import type { MarkdownHeading } from "astro";

interface Props {
    /** The page's title: heads the list and leads back to the top. */
    title: string;
    headings: MarkdownHeading[];
    sources?: { title: string; href: string }[];
    /** The line to quote when citing this page. Shown with a button that copies it. */
    cite?: string;
}

const { title, sources = [], cite } = Astro.props;
const headings = Astro.props.headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<aside class="post-side">
    {
        headings.length > 1 && (
            <details class="contents" open>
                <summary>
                    <a href="#main">{title}</a>
                </summary>
                <ol>
                    {headings.map((heading) => (
                        <li class:list={{ sub: heading.depth === 3 }}>
                            <a href={`#${heading.slug}`}>{heading.text}</a>
                        </li>
                    ))}
                </ol>
            </details>
        )
    }
    {
        (sources.length > 0 || cite) && (
            <div class="post-extra">
                {sources.length > 0 && (
                    <section aria-labelledby="sources-title">
                        <h2 class="label" id="sources-title">sources</h2>
                        <ol class="sources">
                            {sources.map((source, index) => (
                                <li id={`source-${index + 1}`}>
                                    <a href={source.href}>{source.title}</a>
                                </li>
                            ))}
                        </ol>
                    </section>
                )}
                {cite && (
                    <details class="cite">
                        <summary>cite this</summary>
                        <p class="cite-text">{cite}</p>
                        <p class="note">
                            Free to quote and reuse with credit, not commercially (<a href="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</a>).
                        </p>
                        <button type="button" class="cite-copy" hidden>copy</button>
                    </details>
                )}
            </div>
        )
    }
</aside>

<script>
    // The copy button only appears where copying works.
    const copy = document.querySelector<HTMLButtonElement>(".cite-copy");
    if (copy && navigator.clipboard) {
        copy.hidden = false;
        copy.addEventListener("click", () => {
            void navigator.clipboard.writeText(document.querySelector(".cite-text")?.textContent ?? "").then(() => (copy.textContent = "copied"));
        });
    }

    // A link in the text that goes to one of the sources gets that source's
    // number after it. Pointing at the number, or clicking it, shows which source it is.
    const sources = [...document.querySelectorAll<HTMLElement>(".sources li")];
    const page = (href: string) => href.split("#")[0]!.replace(/\/$/, "");
    const numbers = new Map(sources.map((item, index) => [page(item.querySelector("a")?.href ?? ""), index + 1]));
    for (const link of document.querySelectorAll<HTMLAnchorElement>(".post-body .prose a[href^='http']")) {
        const number = numbers.get(page(link.href));
        if (!number) continue;
        const source = sources[number - 1]!;
        const mark = document.createElement("sup");
        mark.className = "ref";
        const jump = document.createElement("a");
        jump.href = `#${source.id}`;
        jump.textContent = String(number);
        jump.setAttribute("aria-label", `Source ${number}: ${source.textContent?.trim() ?? ""}`);
        const point = (on: boolean) => source.classList.toggle("pointed", on);
        jump.addEventListener("pointerenter", () => point(true));
        jump.addEventListener("pointerleave", () => point(false));
        jump.addEventListener("focus", () => point(true));
        jump.addEventListener("blur", () => point(false));
        jump.addEventListener("click", (event) => {
            // Bring the source into view without throwing the page to it.
            event.preventDefault();
            source.scrollIntoView({ block: "nearest", behavior: "smooth" });
            source.classList.remove("flash");
            void source.offsetWidth;
            source.classList.add("flash");
        });
        mark.append(jump);
        link.after(mark);
    }

    // Mark the link for the section nearest the top of the view.
    const contents = document.querySelector<HTMLElement>(".contents");
    if (contents) {
        // In the margin it is always open; folded away it starts closed.
        const beside = matchMedia("(min-width: 72rem)");
        const fold = () => contents.toggleAttribute("open", beside.matches);
        beside.addEventListener("change", fold);
        fold();

        const links = new Map<Element, HTMLAnchorElement>();
        for (const link of contents.querySelectorAll<HTMLAnchorElement>("ol a")) {
            const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
            if (heading) links.set(heading, link);
        }

        const seen = new Set<Element>();
        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (entry.isIntersecting) seen.add(entry.target);
                    else seen.delete(entry.target);
                }
                // The first heading in view, or failing that the last one scrolled past.
                const headings = [...links.keys()];
                const current =
                    headings.find((heading) => seen.has(heading)) ??
                    headings.filter((heading) => heading.getBoundingClientRect().top < 0).at(-1);
                for (const [heading, link] of links) {
                    if (heading === current) link.setAttribute("aria-current", "true");
                    else link.removeAttribute("aria-current");
                }
            },
            { rootMargin: "0px 0px -60% 0px" },
        );
        for (const heading of links.keys()) observer.observe(heading);
    }
</script>
