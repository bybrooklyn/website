---
// A timeline you step through. It shows one moment at a time, and each
// scroll action moves it on by exactly one: a notch of the wheel, a swipe on a
// touchpad or a touch screen, an arrow key. While there are moments left the
// page holds still around it; past the last one it scrolls on as usual. A
// marker moves down a rail at the side to show how far along you are.
//
// That behaviour is added by the script below. Without scripts, or for anyone
// who has asked for reduced motion, it is an ordinary list of every moment.
import "../styles/timeline.css";
---

<section class="timeline">
    <div class="timeline-stage">
        <div class="timeline-rail" aria-hidden="true"><span class="timeline-marker"></span></div>
        <ol class="timeline-moments">
            <slot />
        </ol>
        <p class="timeline-count" aria-hidden="true"></p>
    </div>
</section>

<script>
    const still = matchMedia("(prefers-reduced-motion: reduce)");

    /** Further input waits this long: a little more than the 0.5s transition in timeline.css. */
    const MOVE = 520;

    for (const timeline of document.querySelectorAll<HTMLElement>(".timeline")) {
        const moments = [...timeline.querySelectorAll<HTMLElement>(".moment")];
        const stage = timeline.querySelector<HTMLElement>(".timeline-stage");
        const rail = timeline.querySelector<HTMLElement>(".timeline-rail");
        const count = timeline.querySelector<HTMLElement>(".timeline-count");
        if (moments.length < 2 || !stage || !rail || !count || still.matches) continue;

        const last = moments.length - 1;
        moments.forEach((_, index) => {
            const tick = document.createElement("span");
            tick.className = "timeline-tick";
            tick.style.top = `${(index / last) * 100}%`;
            rail.append(tick);
        });
        const ticks = [...rail.querySelectorAll<HTMLElement>(".timeline-tick")];
        timeline.classList.add("live");

        let current = -1;
        let busyUntil = 0;

        const show = (index: number) => {
            current = index;
            timeline.style.setProperty("--progress", String(index / last));
            moments.forEach((moment, at) => {
                moment.classList.toggle("current", at === index);
                moment.classList.toggle("before", at < index);
            });
            ticks.forEach((tick, at) => tick.classList.toggle("passed", at <= index));
            count.textContent = `${index + 1} / ${moments.length}`;
        };

        /** The stage is as tall as its tallest moment, so nothing below it moves as they change. */
        const measure = () => timeline.style.setProperty("--tallest", `${Math.max(...moments.map((moment) => moment.scrollHeight))}px`);

        // The page holds still, with the stage resting on a line a little way
        // down the window, for as long as there are moments left in the
        // direction of travel. Past the last (or back past the first) it scrolls on.
        const line = () => Math.max(16, Math.min(innerHeight * 0.2, (innerHeight - stage.offsetHeight) / 2));
        const top = () => stage.getBoundingClientRect().top;
        const rest = () => scrollTo({ top: top() + scrollY - line(), behavior: "instant" });
        const holds = (direction: number): boolean => {
            if (direction > 0 ? current >= last : current <= 0) return false;
            const offset = top() - line();
            return direction > 0 ? offset <= 2 && offset > -stage.offsetHeight * 0.6 : offset >= -2 && offset < innerHeight * 0.5;
        };

        /** Move one moment, unless the last move is still finishing. */
        const step = (direction: number) => {
            if (Math.abs(top() - line()) > 1) rest();
            if (performance.now() < busyUntil) return;
            busyUntil = performance.now() + MOVE;
            show(current + direction);
        };

        // Wheel and touchpad: the first event of a gesture moves one moment and
        // the rest of it, coasting included, is swallowed. A gesture is new after
        // a pause, or when the speed picks up again instead of dying away.
        let wheelAt = 0;
        let wheelSize = 0;
        let swallowing = false;
        let inputAt = 0;
        window.addEventListener(
            "wheel",
            (event) => {
                const size = Math.abs(event.deltaY);
                const fresh = event.timeStamp - wheelAt > 180 || (size >= 50 && size >= wheelSize && performance.now() >= busyUntil);
                wheelAt = event.timeStamp;
                wheelSize = size;
                inputAt = performance.now();
                if (event.ctrlKey || size === 0) return;
                if (fresh) swallowing = false;
                if (holds(Math.sign(event.deltaY))) {
                    event.preventDefault();
                    if (fresh) step(Math.sign(event.deltaY));
                    swallowing = true;
                } else if (swallowing) event.preventDefault();
            },
            { passive: false },
        );

        // Scrolling that arrives at the line with moments still to show stops
        // there, so coasting or a flick does not carry the stage past.
        let before = scrollY;
        let touchAt = 0;
        window.addEventListener(
            "scroll",
            () => {
                const direction = Math.sign(scrollY - before);
                before = scrollY;
                // Only for scrolling the visitor is doing by wheel, touch or keys; the scrollbar and links pass freely.
                // A finger still on the screen is left alone: the page cannot be taken from under it.
                if (direction === 0 || touching || performance.now() - inputAt > 1200 || !holds(direction)) return;
                if (Math.abs(top() - line()) <= 1) return;
                if (performance.now() - touchAt < 1500) {
                    // A flick on a touch screen keeps coasting unless scrolling is switched off for a moment.
                    const root = document.documentElement;
                    root.style.overflow = "hidden";
                    requestAnimationFrame(() => (root.style.overflow = ""));
                }
                rest();
                before = scrollY;
                swallowing = true;
            },
            { passive: true },
        );

        // Touch: a swipe moves one moment when the finger lifts.
        let touchY = 0;
        let touching = false;
        let taken: boolean | undefined;
        window.addEventListener(
            "touchstart",
            (event) => {
                touchY = event.touches[0]?.clientY ?? 0;
                touching = true;
                taken = undefined;
                inputAt = touchAt = performance.now();
            },
            { passive: true },
        );
        window.addEventListener(
            "touchmove",
            (event) => {
                inputAt = touchAt = performance.now();
                const direction = Math.sign(touchY - (event.touches[0]?.clientY ?? touchY));
                // The first movement decides whether this swipe steps the timeline or scrolls the page.
                if (taken === undefined && direction !== 0) taken = holds(direction);
                if (taken && event.cancelable) event.preventDefault();
            },
            { passive: false },
        );
        window.addEventListener("touchend", (event) => {
            inputAt = touchAt = performance.now();
            touching = event.touches.length > 0;
            const moved = touchY - (event.changedTouches[0]?.clientY ?? touchY);
            if (taken && Math.abs(moved) > 24 && holds(Math.sign(moved))) step(Math.sign(moved));
            else if (!taken && holds(Math.sign(moved))) rest();
            taken = undefined;
        });
        window.addEventListener("touchcancel", () => (touching = false));

        window.addEventListener("keydown", (event) => {
            inputAt = performance.now();
            if (event.defaultPrevented || event.ctrlKey || event.metaKey || event.altKey) return;
            if (event.target instanceof HTMLElement && event.target.closest("input, textarea, select, [contenteditable]")) return;
            const forward = ["ArrowDown", "PageDown"].includes(event.key) || (event.key === " " && !event.shiftKey);
            const back = ["ArrowUp", "PageUp"].includes(event.key) || (event.key === " " && event.shiftKey);
            if (!forward && !back) return;
            if (holds(forward ? 1 : -1)) {
                event.preventDefault();
                step(forward ? 1 : -1);
            }
        });

        window.addEventListener("resize", measure);
        void document.fonts.ready.then(measure);
        measure();
        show(0);
    }
</script>
