---
// A terminal that plays what a program printed: a session written from its
// real output (a file in src/terminal/), or a recording (an asciinema .cast
// file in public/casts/). Nothing runs; see src/scripts/terminal.ts.
//
//   <Terminal session="mfetchy" title="mfy --help" />
//   <Terminal cast="/casts/mfetchy.cast" title="mFetchy's menu" />

interface Props {
    /** The name of a session in src/terminal/, without ".json". */
    session?: string;
    /** The address of a recording. */
    cast?: string;
    /** Shown in the bar along the top, and read out as what this is. */
    title: string;
    caption?: string;
}

const { session, cast, title, caption } = Astro.props;
const sessions = import.meta.glob<{ default: unknown }>("../terminal/*.json", { eager: true });
const data = session ? sessions[`../terminal/${session}.json`]?.default : undefined;
if (session && !data) throw new Error(`No session called ${session} in src/terminal/.`);
const size = (data as { cols?: number; rows?: number } | undefined) ?? {};
---

<figure class="terminal" data-terminal data-cast={cast} style={`--cols:${size.cols ?? 80};--rows:${size.rows ?? 24}`}>
    <div class="terminal-bar">
        <span class="terminal-title">{title}</span>
        <button type="button" class="terminal-again" hidden>play again</button>
    </div>
    <div class="terminal-fit">
        <div class="terminal-screen" role="img" aria-label={`A terminal showing ${title}.`}></div>
    </div>
    {data && <script type="application/json" set:html={JSON.stringify(data)} />}
    {caption && <figcaption class="note">{caption}</figcaption>}
</figure>

<script>
    import "../scripts/terminal";
</script>
