---
// A terminal that plays a recording of a real run of a program: an asciinema
// .cast file in public/casts/. Nothing runs; see src/scripts/terminal.ts.
//
//   <Terminal cast="/casts/mfetchy.cast" title="mfy" caption="…" />

interface Props {
    /** The address of the recording. */
    cast: string;
    /** Shown in the bar along the top, and read out as what this is. */
    title: string;
    caption?: string;
}

const { cast, title, caption } = Astro.props;
---

<figure class="terminal" data-terminal data-cast={cast}>
    <div class="terminal-window">
        <div class="terminal-bar">
            <span class="terminal-lights" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="terminal-title">{title}</span>
            <span class="terminal-buttons">
                <button type="button" class="terminal-again" hidden>play again</button>
                <button type="button" class="terminal-grow" aria-expanded="false">full size</button>
            </span>
        </div>
        <div class="terminal-fit">
            <div class="terminal-screen" role="img" aria-label={`A terminal showing ${title}.`}></div>
        </div>
    </div>
    {caption && <figcaption class="note">{caption}</figcaption>}
</figure>

<script>
    import "../scripts/terminal";
</script>
