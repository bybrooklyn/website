---
// A terminal that plays a recording of a real run of a program: an asciinema
// .cast file in public/casts/. Nothing runs; see src/scripts/terminal.ts.
//
//   <Terminal cast="/casts/mfetchy.cast" title="mfy" caption="…" />

interface Props {
    /** The address of the recording. */
    cast: string;
    /** Shown in the bar along the top, and read out as what this is. */
    title: string;
    caption?: string;
}

const { cast, title, caption } = Astro.props;
---

<figure class="terminal" data-terminal data-cast={cast}>
    <div class="terminal-window">
        <div class="terminal-bar">
            <span class="terminal-lights" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="terminal-title">{title}</span>
            <span class="terminal-buttons">
                {/* Each button is a picture of what it does: play or play again, and full size or close. The words are for screen readers. */}
                <button type="button" class="terminal-again" data-shows="again" aria-label="Play again" title="Play again" hidden>
                    <svg class="for-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6l7.4-4.8z" fill="currentColor" stroke="none"></path></svg>
                    <svg class="for-again" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.2 8a4.8 4.8 0 1 0 1.5-3.5M3 2.2v3.2h3.2"></path></svg>
                </button>
                <button type="button" class="terminal-grow" data-shows="grow" aria-expanded="false" aria-label="Full size" title="Full size">
                    <svg class="for-grow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 6V2.5H6M10 2.5h3.5V6M13.5 10v3.5H10M6 13.5H2.5V10"></path></svg>
                    <svg class="for-close" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9"></path></svg>
                </button>
            </span>
        </div>
        <div class="terminal-fit">
            <div class="terminal-screen" role="img" aria-label={`A terminal showing ${title}.`}></div>
        </div>
    </div>
    {caption && <figcaption class="note">{caption}</figcaption>}
</figure>

<script>
    import "../scripts/terminal";
</script>
