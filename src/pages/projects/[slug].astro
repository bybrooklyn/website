---
import "../../styles/content";
import PrevNext from "../../components/PrevNext.astro";
import DrawnCover from "../../components/DrawnCover.astro";
import Picture from "../../components/Picture.astro";
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import "../../styles/blog.css";
import "../../styles/projects.css";
import "../../styles/viewer.css";
import Contents from "../../components/Contents.astro";
import Opened from "../../layouts/Opened.astro";
import { formatDate } from "../../lib/posts";
import { getProjects, projectFacts, type Project } from "../../lib/projects";

export const getStaticPaths = (async () => {
    const projects = await getProjects();
    return projects.map((project, index) => ({
        params: { slug: project.id },
        props: { project, previous: projects[index - 1], next: projects[index + 1] },
    }));
}) satisfies GetStaticPaths;

interface Props {
    project: Project;
    previous?: Project;
    next?: Project;
}

const { project, previous, next } = Astro.props;
const { name, summary, language, status, repo, link, cover, coverAlt, pixel, gallery } = project.data;
// Entries cached by the dev server from before `get` existed arrive without it.
const get = project.data.get ?? [];
const { Content, headings } = await render(project);
const facts = projectFacts(project);

// A row with a name is one GitHub can bring up to date in the browser. Those
// rows are always written for a public repository, and hidden while they
// have nothing to say (no release yet, no stars), so the script only has to
// fill them in.
interface Row {
    label: string;
    value: string;
    fact?: "release" | "stars" | "forks" | "updated";
    hidden?: boolean;
}
const live = facts?.public === true;
const count = (label: string, fact: "stars" | "forks", value: number): Row[] => (value > 0 || live ? [{ label, value: String(value), fact, hidden: value === 0 }] : []);
const rows: Row[] = [{ label: "language", value: language }];
if (status) rows.push({ label: "status", value: status });
if (facts?.license) rows.push({ label: "license", value: facts.license });
if (facts?.release || live) rows.push({ label: "latest release", value: facts?.release ?? "", fact: "release", hidden: !facts?.release });
if (facts) rows.push(...count("stars", "stars", facts.stars), ...count("forks", "forks", facts.forks ?? 0));
if (facts) rows.push({ label: "last updated", value: formatDate(new Date(facts.updated)), fact: "updated" });
---

<Opened title={name} description={summary} image={cover} back={{ href: "/projects/", label: "projects" }}>
    <article class="post">
        <header class="post-header">
            <p class="post-meta">
                <span>{language}</span>
                {status && <span>{status}</span>}
            </p>
            <h1>{name}</h1>
            <p class="lede">{summary}</p>
        </header>

        {!cover && <DrawnCover class="post-cover" {name} {language} />}
        {
            cover && (
                <Picture class:list={["post-cover", { pixel }]}
                    src={cover}
                    alt={coverAlt ?? ""}
                    widths={[640, 960, 1440]}
                    sizes="(min-width: 60rem) 44rem, 100vw"
                    loading="eager"
                    fetchpriority="high"
                />
            )
        }

        <div class="post-body">
            <Contents title={name} {headings} />
            <div class="prose">
                {
                    get.length > 0 && (
                        <p class="get">
                            {get.map((place) => (
                                <a href={place.href}>{place.label}</a>
                            ))}
                        </p>
                    )
                }
                <dl class="facts" data-repo={live ? repo : undefined}>
                    {
                        rows.map((row) => (
                            <div hidden={row.hidden}>
                                <dt>{row.label}</dt>
                                <dd data-fact={row.fact}>{row.value}</dd>
                            </div>
                        ))
                    }
                    {
                        repo && (
                            <div>
                                <dt>source</dt>
                                <dd>
                                    {/* A repository that is still private is named, not linked: the link would be a dead end. */}
                                    {facts && !facts.public ? (
                                        <>
                                            github.com/{repo}
                                            <span class="note"> (not public yet)</span>
                                        </>
                                    ) : (
                                        <a href={`https://github.com/${repo}`}>github.com/{repo}</a>
                                    )}
                                </dd>
                            </div>
                        )
                    }
                    {
                        link && (
                            <div>
                                <dt>link</dt>
                                <dd>
                                    <a href={link.href}>{link.label}</a>
                                </dd>
                            </div>
                        )
                    }
                </dl>

                <Content />
            </div>
        </div>

        {
            gallery.length > 0 && (
                <section class="gallery" aria-label="Screenshots">
                    {gallery.map((picture) => (
                        <a href={picture.src.src}>
                            <Picture class:list={{ pixel }}
                                src={picture.src}
                                alt={picture.alt}
                                widths={[480, 960]}
                                sizes="(min-width: 60rem) 24rem, 50vw"
                            />
                        </a>
                    ))}
                </section>
            )
        }

        <PrevNext
            label="More projects"
            previous={previous && { href: `/projects/${previous.id}/`, note: "previous", title: previous.data.name }}
            next={next ? { href: `/projects/${next.id}/`, note: "next", title: next.data.name } : { href: "/projects/", note: "back to the list", title: "all projects" }}
        />
    </article>
</Opened>

<script>
    import "../../scripts/viewer";
</script>

<script>
    // On a public project's page, ask GitHub for today's numbers and put them
    // in place of the ones the site was built with. If GitHub does not answer
    // (offline, blocked, or more than its sixty questions an hour), the built
    // numbers stay. Answers are kept for an hour so that moving between
    // projects does not ask again.
    const list = document.querySelector<HTMLElement>(".facts[data-repo]");
    const repo = list?.dataset.repo;

    interface Answer {
        at: number;
        stars: number;
        forks: number;
        updated: string;
        release: string | null;
    }

    if (list && repo) {
        const key = `github:${repo}`;
        const date = new Intl.DateTimeFormat("en-US", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });

        const show = (answer: Answer) => {
            const set = (fact: string, value: string | null) => {
                const cell = list.querySelector<HTMLElement>(`[data-fact="${fact}"]`);
                if (!cell?.parentElement) return;
                if (value) cell.textContent = value;
                cell.parentElement.hidden = !value;
            };
            set("stars", answer.stars > 0 ? String(answer.stars) : null);
            set("forks", answer.forks > 0 ? String(answer.forks) : null);
            set("release", answer.release);
            set("updated", date.format(new Date(answer.updated)));
        };

        const ask = async (): Promise<Answer | undefined> => {
            const headers = { Accept: "application/vnd.github+json" };
            const found = await fetch(`https://api.github.com/repos/${repo}`, { headers });
            if (!found.ok) return undefined;
            const info = (await found.json()) as { stargazers_count: number; forks_count: number; pushed_at: string };
            // The list of releases, not "the latest one": with no release that answers
            // with an empty list where the other answers "not found", an error in the console.
            const releases = await fetch(`https://api.github.com/repos/${repo}/releases?per_page=5`, { headers });
            const published = releases.ok ? ((await releases.json()) as { tag_name: string; draft: boolean; prerelease: boolean }[]) : [];
            const release = published.find((item) => !item.draft && !item.prerelease)?.tag_name ?? null;
            return { at: Date.now(), stars: info.stargazers_count, forks: info.forks_count, updated: info.pushed_at, release };
        };

        void (async () => {
            try {
                const kept = JSON.parse(sessionStorage.getItem(key) ?? "null") as Answer | null;
                if (kept && Date.now() - kept.at < 3_600_000) return show(kept);
            } catch {
                // Nothing kept, or storage is off: ask.
            }
            try {
                const answer = await ask();
                if (!answer) return;
                show(answer);
                try {
                    sessionStorage.setItem(key, JSON.stringify(answer));
                } catch {
                    // Shown all the same.
                }
            } catch {
                // GitHub could not be reached: the built numbers stay.
            }
        })();
    }
</script>
