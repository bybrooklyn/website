---
import DrawnCover from "../../components/DrawnCover.astro";
import "../../styles/blog.css";
import "../../styles/projects.css";
import Base from "../../layouts/Base.astro";
import { site } from "../../data/site";
import { ownHue } from "../../lib/drawn";
import { getProjects, projectPage } from "../../lib/projects";

const projects = await getProjects();
---

<Base title="projects" description="Things Charlotte has made.">
    <div class="page-head">
        <h1>projects</h1>
        <p class="lede">Things I've made. The rest is on <a href={site.github}>GitHub</a>.</p>
    </div>

    <ul class="project-list">
        {
            projects.map((project) => (
                <li>
                    <a href={projectPage(project)}>
                        {/* Every project has an emblem in the list, a shape and a color of its own to find it by. Its pictures are for when it is opened. */}
                        <DrawnCover class="project-thumb" name={project.data.name} language={project.data.language} hue={ownHue(project.data.order)} />
                        <div>
                            <h2>{project.data.name}</h2>
                            <p>{project.data.summary}</p>
                            <p class="post-meta">
                                <span>{project.data.language}</span>
                                {project.data.status && <span>{project.data.status}</span>}
                            </p>
                        </div>
                    </a>
                </li>
            ))
        }
    </ul>
</Base>
