---
// mdQuire, the editor, filling the window under its top: one piece of two lines that stays whole
// as the page scrolls. The first line is a trail, "charlotte [flags] / mdQuire / the document's
// name", her name and flags exactly where every page of the site has them, then the menu words,
// and how saving stands at the right. The second line is the tools, in Google Docs' order. The
// editor (src/quire/md/editor.ts) puts its parts into the places marked here. It is unlisted, and kept
// out of search and the sitemap, until she says otherwise.
import Document from "../layouts/Document.astro";
import Flags from "../components/Flags.astro";
import { site } from "../data/site";
import "../styles/quire.css";
import "../styles/quire-markdown.css";
import "../styles/quire-extras.css";
---

<Document title="mdQuire" description="A word processor for Markdown files." unlisted bodyClass="quire-app" icon="/mdquire/icon.svg">
    <header class="quire-top">
        <div class="quire-top-in">
            <div class="quire-top-line">
                <nav class="quire-trail" aria-label="Where you are">
                    <div class="site-id">
                        <a class="site-name" href="/">{site.name.toLowerCase()}</a>
                        <Flags />
                    </div>
                    <span class="quire-stroke quire-word-stroke" aria-hidden="true">/</span>
                    <a class="quire-word" href="/mdquire/" aria-label="mdQuire: all documents">mdQuire</a>
                    <span class="quire-stroke quire-name-stroke" aria-hidden="true">/</span>
                    <span class="quire-name-home"></span>
                </nav>
                <div class="quire-menus-home"></div>
                <div class="quire-status-home"></div>
            </div>
            <div class="quire-bar-home"></div>
        </div>
    </header>
    <main id="main" tabindex="-1">
        <div id="quire" class="quire-host"></div>
    </main>
</Document>

<script>
    import "../scripts/mdquire";
</script>
