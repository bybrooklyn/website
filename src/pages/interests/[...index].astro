---
// /interests/: what she likes. Games, movies, shows and music are lists of rows, as the projects are:
// a small cover, the name, one line of hers, and a small line saying what it is and when. A row opens
// the thing's own page, /interests/<name>/, in the site's panel. Hobbies are words alone.
//
// While the owner compares two ways of opening a thing, this page also carries the sheet that the
// first build opened things in (InterestSheet.astro): with ?sheet on the address a row opens that
// instead. Whichever she does not choose is to be taken out (docs/interests.md).
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import "../../styles/blog.css";
import "../../styles/projects.css";
import "../../styles/interests.css";
import Base from "../../layouts/Base.astro";
import InterestSheet from "../../components/InterestSheet.astro";
import Picture from "../../components/Picture.astro";
import { site } from "../../data/site";
import { getInterests, getParts, inSection, metaOf, type Interest } from "../../lib/interests";

// A rest route with one fixed path (/interests/), so that the page is not built at all while it is a
// draft that is not being shown.
export const getStaticPaths = (async () => ((await getInterests()).length > 0 ? [{ params: { index: undefined } }] : [])) satisfies GetStaticPaths;

const all = await getInterests();
const parts = await Promise.all((await getParts()).map(async (part) => ({ part, Words: (await render(part)).Content })));
const screens = await Promise.all(all.map(async (interest) => ({ interest, Words: (await render(interest)).Content })));
const title = (interest?: Interest) => `${interest ? interest.data.name : "interests"} · ${site.name.toLowerCase()}`;
---

<Base title="interests" description="The games, films, shows and music Charlotte likes, and her hobbies.">
    <div class="page-head">
        <h1>interests</h1>
        <p class="lede">What I play, watch and listen to, and what else I do.</p>
    </div>

    <p class="note interest-compare">
        For comparing, while this page is a draft: a row opens in <a href="/interests/">the site's panel</a> or in <a href="/interests/?sheet">a sheet</a>.
    </p>

    {
        parts.map(({ part, Words }) => (
            <section class="interest-part" aria-labelledby={`part-${part.id}`}>
                <h2 class="label" id={`part-${part.id}`}>
                    {part.data.title}
                </h2>
                <div class="interest-words prose">
                    <Words />
                </div>
                {part.data.groups.map((group) => (
                    <ul class="project-list interest-list">
                        {inSection(all, group).map((interest) => (
                            <li>
                                <a href={`/interests/${interest.id}/`} data-open={interest.id}>
                                    <Picture class="project-thumb" src={interest.data.cover} alt="" width={240} data-no-view />
                                    <div>
                                        <h3>{interest.data.name}</h3>
                                        <p>{interest.data.summary}</p>
                                        <p class="post-meta">
                                            {metaOf(interest).map((word) => (
                                                <span>{word}</span>
                                            ))}
                                        </p>
                                    </div>
                                </a>
                            </li>
                        ))}
                    </ul>
                ))}
            </section>
        ))
    }

    <p class="interest-credit note">The covers, posters and album art belong to the people who made them, and so do the trailers.</p>

    <InterestSheet {screens} listTitle={title()} titleOf={title} />
</Base>

<script>
    import "../../scripts/interests";
</script>
