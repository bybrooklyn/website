---
// The QR code maker and reader as a page of its own: make a code for a link, a Wi-Fi login, a contact, an
// email, a call or a message, styled as wished, and read the codes in a picture, all in this browser
// (src/quire/qr/page.ts). It is unlisted, kept out of search and the sitemap, and linked from nowhere,
// until she says otherwise.
import Document from "../layouts/Document.astro";
import Flags from "../components/Flags.astro";
import { site } from "../data/site";
import "../styles/quire.css";
import "../styles/quire-img.css";
import "../styles/quire-qr.css";
---

<Document title="QR codes" description="Makes and reads QR codes, in your browser." unlisted bodyClass="quire-app quire-qr-page" icon="/mdquire/icon.svg">
    <header class="quire-top">
        <div class="quire-top-in">
            <div class="quire-top-line">
                <nav class="quire-trail" aria-label="Where you are">
                    <div class="site-id">
                        <a class="site-name" href="/">{site.name.toLowerCase()}</a>
                        <Flags />
                    </div>
                    <span class="quire-stroke quire-word-stroke" aria-hidden="true">/</span>
                    <a class="quire-word" href="/qr/">qr</a>
                </nav>
            </div>
        </div>
    </header>
    <main id="main" tabindex="-1">
        <div id="qr" class="quire-qr-host"></div>
    </main>
</Document>

<script>
    import "../scripts/qr";
</script>
