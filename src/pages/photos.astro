---
// /photos/: photographs, grouped into albums, with tags to filter by.
// Clicking one opens it large. The list is arranged in the editor.
import { getImage, Image } from "astro:assets";
import "../styles/photos.css";
import Base from "../layouts/Base.astro";
import { formatDate } from "../lib/posts";
import { albums, exposure, photos, tags } from "../lib/photos";

const shown = await Promise.all(
    albums.map(async (album) => ({
        title: album.title,
        photos: await Promise.all(
            album.photos.map(async (photo) => ({
                photo,
                large: await getImage({ src: photo.image, width: Math.min(photo.image.width, 2000), format: "avif" }),
                details: [photo.taken && formatDate(new Date(`${photo.taken}T12:00:00`)), exposure(photo)].filter(Boolean).join(" · "),
            })),
        ),
    })),
);
---

<Base title="photos" description="Photographs by Charlotte." unlisted={photos.length === 0}>
    <div class="page-head">
        <h1>photos</h1>
    </div>

    {
        tags.length > 0 && (
            <p class="photo-tags" hidden>
                <button type="button" data-tag="" aria-pressed="true">all</button>
                {tags.map((tag) => <button type="button" data-tag={tag} aria-pressed="false">{tag}</button>)}
            </p>
        )
    }

    {
        shown.map((album) => (
            <section class="album">
                {album.title && <h2>{album.title}</h2>}
                <ul class="photo-grid">
                    {album.photos.map(({ photo, large, details }) => (
                        <li data-tags={photo.tags.join("|")}>
                            <a href={large.src} data-caption={photo.caption ?? ""} data-details={details}>
                                <Image
                                    format="avif"
                                    src={photo.image}
                                    alt={photo.caption ?? ""}
                                    widths={[480, 960]}
                                    sizes="(min-width: 60rem) 22rem, (min-width: 36rem) 50vw, 100vw"
                                />
                            </a>
                        </li>
                    ))}
                </ul>
            </section>
        ))
    }
    {shown.length === 0 && <p class="lede">Nothing here yet.</p>}

    <dialog class="photo-view" aria-label="Photo">
        <img alt="" />
        <p class="photo-caption"></p>
        <p class="photo-details note"></p>
        <form method="dialog"><button aria-label="Close">close</button></form>
    </dialog>
</Base>

<script>
    const view = document.querySelector<HTMLDialogElement>(".photo-view");
    const links = [...document.querySelectorAll<HTMLAnchorElement>(".photo-grid a")];
    const image = view?.querySelector("img");
    let open = -1;

    /** The photos a visitor can currently see, so stepping skips filtered ones. */
    const visible = () => links.filter((link) => !link.closest("li")?.hidden);

    function show(link: HTMLAnchorElement | undefined): void {
        if (!view || !image || !link) return;
        open = links.indexOf(link);
        image.src = link.href;
        image.alt = link.dataset.caption ?? "";
        view.querySelector(".photo-caption")!.textContent = link.dataset.caption ?? "";
        view.querySelector(".photo-details")!.textContent = link.dataset.details ?? "";
        if (!view.open) view.showModal();
    }

    for (const link of links) {
        link.addEventListener("click", (event) => {
            if (event.ctrlKey || event.metaKey || event.shiftKey) return;
            event.preventDefault();
            show(link);
        });
    }

    view?.addEventListener("keydown", (event) => {
        const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key];
        if (!step) return;
        const around = visible();
        show(around[around.indexOf(links[open]!) + step]);
    });
    // A click on the dark surround, outside the picture, closes it.
    view?.addEventListener("click", (event) => {
        if (event.target === view) view.close();
    });

    const tagBar = document.querySelector<HTMLElement>(".photo-tags");
    if (tagBar) {
        tagBar.hidden = false;
        tagBar.addEventListener("click", (event) => {
            const button = (event.target as Element).closest<HTMLButtonElement>("button[data-tag]");
            if (!button) return;
            const tag = button.dataset.tag ?? "";
            for (const other of tagBar.querySelectorAll("button")) other.setAttribute("aria-pressed", String(other === button));
            for (const item of document.querySelectorAll<HTMLElement>(".photo-grid li")) {
                item.hidden = tag !== "" && !(item.dataset.tags ?? "").split("|").includes(tag);
            }
            for (const album of document.querySelectorAll<HTMLElement>(".album")) {
                album.hidden = !album.querySelector(".photo-grid li:not([hidden])");
            }
        });
    }
</script>
