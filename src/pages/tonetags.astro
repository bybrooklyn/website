---
// /tonetags/: what tone tags mean, with a search. A tone tag is a short mark after a message,
// behind a slash, that says how the message is meant. It opens like a project (its words are
// src/content/projects/tone-tags.mdx, which says `opens: /tonetags/`): the thing at the top, then
// what it is.
//
// The whole list is written here, A to Z in columns under a strip of the most used, so the page
// reads without scripts.
// src/scripts/tonetags.ts then narrows it as the box is typed in. The list and how it is searched
// are in src/tonetags/.
import "../styles/content";
import "../styles/blog.css";
import "../styles/projects.css";
import "../styles/tonetags.css";
import { getEntry, render } from "astro:content";
import PrevNext from "../components/PrevNext.astro";
import Opened from "../layouts/Opened.astro";
import { getProjects, projectPage } from "../lib/projects";
import { projectShare, sharePicture } from "../lib/share";
import { tags } from "../tonetags/tags";

const project = (await getEntry("projects", "tone-tags"))!;
const { name, summary, language } = project.data;
const { Content } = await render(project);
const projects = await getProjects();
const at = projects.findIndex((each) => each.id === project.id);
const previous = projects[at - 1];
const next = projects[at + 1];

const placed = tags.map((tag, place) => ({ tag, place }));
/** The few seen every day, for the strip at the top. */
const everyday = placed.filter((each) => each.tag.common);
/** Every tag by its first spelling, for the columns. */
const all = placed.toSorted((a, b) => a.tag.forms[0]!.localeCompare(b.tag.forms[0]!));
---

<Opened title={name} description={summary} image={sharePicture("project-tone-tags")} facts={projectShare(project)} back={{ href: "/projects/", label: "projects" }}>
    <article class="post tonetags-page">
        <header class="post-header">
            <p class="post-meta"><span>{language}</span></p>
            <h1>{name.toLowerCase()}</h1>
            <p class="lede">{summary}</p>
        </header>

        {/* What a tone tag is, who it helps, and that nobody has to learn them: the project's own words, first, for whoever has never seen one. */}
        <div class="prose tonetags-about">
            <Content />
        </div>

        <div class="tonetags" data-tonetags>
            <label class="tonetags-find">
                <span class="unseen">Search the tags</span>
                <input type="search" placeholder="/j, or what you mean: not angry at you" autocomplete="off" autocapitalize="off" spellcheck="false" />
            </label>
            <p class="tonetags-count note" aria-live="polite"></p>

            {/* the ones seen every day, in a strip; it folds away while something is being looked for */}
            <section class="tonetags-everyday fold open">
                <div>
                    <h2>the ones you will see most</h2>
                    <ul>
                        {everyday.map(({ tag }) => (
                            <li>
                                <code>/{tag.forms[0]}</code> {tag.means}
                            </li>
                        ))}
                    </ul>
                </div>
            </section>

            {/* all of them, A to Z, down three columns: a tag, its meaning, and any other way it is written */}
            <ul class="tonetags-all">
                {all.map(({ tag, place }) => (
                    <li class="fold open" data-tag={place}>
                        <div class="tonetag">
                            <code>/{tag.forms[0]}</code>
                            <span>
                                {tag.means}
                                {tag.forms.length > 1 && <span class="tonetag-also"> also {tag.forms.slice(1).map((form) => `/${form}`).join(", ")}</span>}
                            </span>
                        </div>
                    </li>
                ))}
            </ul>
        </div>

        <PrevNext
            label="More projects"
            previous={previous && { href: projectPage(previous), note: "previous", title: previous.data.name }}
            next={next ? { href: projectPage(next), note: "next", title: next.data.name } : { href: "/projects/", note: "back to the list", title: "all projects" }}
        />
    </article>
</Opened>

<script>
    import "../scripts/tonetags";
</script>
