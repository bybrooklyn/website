---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Post from "../../layouts/Post.astro";
import { getPosts, type Post as Entry } from "../../lib/posts";

export const getStaticPaths = (async () => {
    const posts = await getPosts();
    return posts.map((post, index) => ({
        params: { slug: post.id },
        // The list is newest first, so the newer neighbor is the one before.
        props: { post, newer: posts[index - 1], older: posts[index + 1] },
    }));
}) satisfies GetStaticPaths;

interface Props {
    post: Entry;
    newer?: Entry;
    older?: Entry;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
---

<Post {post} {headings} {newer} {older}>
    <Content />
</Post>
