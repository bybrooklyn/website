---
// A page for trying dictation on its own: a plain editing surface and the microphone control, with
// none of mdQuire's layout around them. Unlisted, and out of search and the sitemap, as /mdquire/ is.
// Add ?fake to the address for the made-up engine the browser tests use.
import Document from "../layouts/Document.astro";
import Flags from "../components/Flags.astro";
import { site } from "../data/site";
import "../styles/quire.css";
---

<Document title="Dictation" description="Trying dictation in mdQuire." unlisted bodyClass="quire-app">
    <header class="quire-top">
        <a class="site-name" href="/">{site.name.toLowerCase()}</a>
        <Flags />
    </header>
    <main id="main" tabindex="-1">
        <div id="dictation-host" class="quire-host quire-editor">
            <div class="quire-column">
                <div class="quire-bar" role="toolbar" aria-label="Dictation">
                    <div class="quire-bar-strip">
                        <div class="quire-bar-group" id="dictation-bar"></div>
                    </div>
                </div>
                <div class="quire-panes">
                    <div class="quire-paper">
                        <div class="prose" id="dictation-paper" aria-label="Document"></div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</Document>

<script>
    import "../quire/dictation/page";
</script>
