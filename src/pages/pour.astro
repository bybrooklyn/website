---
// A page for looking at how a picture is poured in when it arrives (src/scripts/pour.ts): a few of the
// site's photographs, each holding one calm color of its own until it comes, then opening in blobs that
// swell and run together. It can be played again, with sliders for how long it takes, how many blobs,
// how soft their edges are and whether the picture starts out of focus. It is unlisted, kept out of search and
// the sitemap, and linked from nowhere; it is here to be judged before the site's pictures are given it.
import { readdir } from "node:fs/promises";
import { join } from "node:path";
import sharp from "sharp";
import Document from "../layouts/Document.astro";
import Flags from "../components/Flags.astro";
import { site } from "../data/site";

// (found from where the site is built, since a built page is no longer beside its source)
const folder = join(process.cwd(), "public", "photos") + "/";
const wanted = ["img-0406-copy", "img-2674", "img-1103", "20241202-171006", "20260711-194551", "img-1507", "20250526-164011", "img-3224"];
const there = new Set(await readdir(folder));
const pictures = await Promise.all(
    wanted
        .filter((name) => there.has(`${name}.avif`))
        .map(async (name) => {
            const file = `${folder}${name}.avif`;
            const { width = 4, height = 3 } = await sharp(file).metadata();
            // one calm color: the picture's average
            const [red, green, blue] = await sharp(file).resize(1, 1, { fit: "fill" }).removeAlpha().raw().toBuffer();
            return { src: `/photos/${name}.avif`, width, height, tint: `rgb(${red} ${green} ${blue})` };
        }),
);
---

<Document title="Pour" description="How a picture is poured in when it arrives." unlisted>
    <header class="pour-top">
        <div class="site-id">
            <a class="site-name" href="/">{site.name.toLowerCase()}</a>
            <Flags />
        </div>
        <form class="pour-ways">
            <label>seconds <input type="range" name="time" min="0.4" max="5" step="0.1" value="1.6" /> <output data-for="time">1.6</output></label>
            <label>blobs <input type="range" name="blobs" min="2" max="10" step="1" value="5" /> <output data-for="blobs">5</output></label>
            <label>soft edges <input type="range" name="soft" min="0" max="4" step="0.1" value="1" /> <output data-for="soft">1</output></label>
            <label>out of focus <input type="range" name="focus" min="0" max="6" step="0.5" value="0" /> <output data-for="focus">0</output></label>
            <button type="button" data-again>pour again</button>
        </form>
    </header>
    <main id="main" tabindex="-1" class="pour-grid">
        {pictures.map((picture) => <img alt="" width={picture.width} height={picture.height} data-src={picture.src} data-pour={picture.tint} style={`background:${picture.tint}`} />)}
    </main>
</Document>

<style>
    .pour-top {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
    }

    .pour-ways {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 1.5rem;
        margin: 0;
        color: var(--muted);
        font-size: 0.9rem;
    }

    .pour-ways label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .pour-ways input {
        width: 7rem;
        accent-color: var(--accent);
    }

    .pour-ways output {
        min-width: 1.8rem;
        color: var(--ink);
        font-variant-numeric: tabular-nums;
    }

    .pour-ways button {
        padding: 0;
        border: 0;
        background: none;
        color: var(--accent);
        font: inherit;
        text-decoration: underline;
        text-underline-offset: 0.2em;
        cursor: pointer;
    }

    .pour-grid {
        position: relative;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
        gap: 1rem;
        align-items: start;
    }

    .pour-grid img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 0.6rem;
    }
</style>

<script>
    import { pour } from "../scripts/pour";

    const pictures = [...document.querySelectorAll<HTMLImageElement>("img[data-src]")];
    const form = document.querySelector<HTMLFormElement>(".pour-ways")!;
    const value = (name: string) => Number((form.elements.namedItem(name) as HTMLInputElement).value);
    let turn = 0;

    /** Each picture is taken away and fetched afresh, so that it truly arrives, and is poured in when it does, as the sliders say. */
    function again() {
        const mine = ++turn;
        const how = { time: value("time") * 1000, blobs: value("blobs"), soft: value("soft"), focus: value("focus") };
        for (const [at, img] of pictures.entries()) {
            img.removeAttribute("src");
            img.onload = () => mine === turn && void pour(img, how);
            setTimeout(() => mine === turn && (img.src = `${img.dataset.src}?${Date.now()}`), 350 + at * 220);
        }
    }

    form.addEventListener("input", (event) => {
        const input = event.target as HTMLInputElement;
        const shown = form.querySelector(`output[data-for="${input.name}"]`);
        if (shown) shown.textContent = input.value;
    });
    // a slider let go plays it again with what it now says
    form.addEventListener("change", again);
    form.querySelector("[data-again]")!.addEventListener("click", again);
    again();
</script>
