---
// /spectrum/: where you are on the gender and sexuality spectrum, as nine sliders and a chart drawn
// from them, with a link that carries every value. Nothing is stored; the values live in the address.
// After Andrea Vos's Spectrum (src/spectrum/LICENSE.md). It is not in the menu: the project page links to it.
//
// The page is written here in English with every slider in the middle, so it reads without
// scripts. src/scripts/spectrum.ts then reads `?c=` and `?l=`, sets the sliders, puts the words in
// the language asked for, and keeps the chart and the address up to date.
import "../styles/spectrum.css";
import Base from "../layouts/Base.astro";
import { axes, groups, HIGHEST, LOWEST, MIDDLE, start } from "../spectrum/axes";
import { breakable, codes, languages, said, words } from "../spectrum/languages";
import { corners, label, place, RINGS, ring, shape } from "../spectrum/radar";

const english = words("en");
const values = start();
const middle = corners(values);
const drawn = shape(middle);
---

<Base title="spectrum" description="Where are you on the gender and sexuality spectrum? Nine sliders, a chart drawn from them, and a link that carries every value. Nothing is stored." accent="pink">
    <div class="spectrum" data-spectrum lang="en" dir="ltr">
        <header class="page-head spectrum-head">
            <h1 data-say="title">{english.title}</h1>
            <p class="lede" data-say="question">{english.question}</p>
            <nav class="spectrum-languages" aria-label="Language">
                {
                    codes.map((code) => (
                        <a href={`/spectrum/?l=${code}`} hreflang={code} lang={code} data-language={code} aria-current={code === "en" ? "true" : undefined}>
                            {languages[code].name}
                        </a>
                    ))
                }
            </nav>
            <p class="note spectrum-translator" hidden></p>
        </header>

        <div class="spectrum-body">
            <ol class="spectrum-sliders">
                {
                    axes.map((axis, index) => (
                        <li class="spectrum-axis" data-axis={axis}>
                            <div class="spectrum-axis-head">
                                <label for={`axis-${axis}`} data-say={`axes.${axis}.label`}>
                                    {english.axes[axis].label}
                                </label>
                                <button type="button" class="spectrum-unset" aria-pressed="false" aria-label={`${english.unset}: ${english.axes[axis].label}`}>
                                    <span data-say="unset">{english.unset}</span>
                                </button>
                            </div>
                            <input type="range" id={`axis-${axis}`} min={LOWEST} max={HIGHEST} step="1" value={values[index]} aria-valuetext={said(english, axis, MIDDLE)} />
                            <div class="spectrum-ends" aria-hidden="true">
                                <span data-say={`axes.${axis}.farLeft`}>{breakable(english.axes[axis].farLeft)}</span>
                                <span data-say={`axes.${axis}.middle`}>{breakable(english.axes[axis].middle)}</span>
                                <span data-say={`axes.${axis}.farRight`}>{breakable(english.axes[axis].farRight)}</span>
                            </div>
                        </li>
                    ))
                }
            </ol>

            <figure class="spectrum-chart">
                <h2 class="label" id="spectrum-chart-name" data-say="chart">{english.chart}</h2>
                <svg viewBox="-215 -138 430 256" role="img" aria-labelledby="spectrum-chart-name" aria-describedby="spectrum-summary">
                    <g class="spectrum-grid">
                        {RINGS.map((value) => <polygon points={ring(value)} />)}
                        {
                            groups.map((_, index) => {
                                const end = place(HIGHEST, index);
                                return <line x1="0" y1="0" x2={end.x.toFixed(1)} y2={end.y.toFixed(1)} />;
                            })
                        }
                    </g>
                    <path class:list={["spectrum-shape", { whole: drawn.whole }]} d={drawn.d} />
                    <g class="spectrum-dots">
                        {
                            middle.map((value, index) => {
                                const at = place(value, index);
                                return <circle r="4.5" cx={at.x.toFixed(1)} cy={at.y.toFixed(1)} />;
                            })
                        }
                    </g>
                    <g class="spectrum-names">
                        {
                            groups.map((group, index) => {
                                const where = label(index);
                                return (
                                    <text x={where.x.toFixed(1)} y={where.y.toFixed(1)} text-anchor={where.anchor} dominant-baseline={where.baseline} data-say={`corners.${group.key}`}>
                                        {english.corners[group.key]}
                                    </text>
                                );
                            })
                        }
                    </g>
                    <text class="spectrum-empty" x="0" y="-12" text-anchor="middle" data-say="empty">
                        {english.empty}
                    </text>
                </svg>
                <figcaption class="note" data-say="hint">{english.hint}</figcaption>
                <ul class="spectrum-summary" id="spectrum-summary">
                    {
                        groups.map((group, index) => (
                            <li data-corner={group.key}>
                                {english.corners[group.key]}: {middle[index]}
                            </li>
                        ))
                    }
                </ul>
            </figure>
        </div>

        <div class="spectrum-share">
            <label for="spectrum-link" class="label" data-say="share">{english.share}</label>
            <div class="spectrum-share-row">
                <input id="spectrum-link" type="text" readonly value="https://bybrooklyn.dev/spectrum/" />
                <button type="button" class="spectrum-copy"><span data-say="copy">{english.copy}</span></button>
                <span class="spectrum-copied" role="status" aria-live="polite"></span>
            </div>
        </div>
    </div>

    <p class="note spectrum-credit">
        Made after <a href="https://avris.it">Andrea Vos</a>'s Spectrum, under the <a href="https://oql.avris.it/license/v1.1">Opinionated Queer License v1.1</a>. Rewritten for this site, with two sliders taken out. Nothing you set is stored or sent anywhere. The values are kept in the address. <a href="/projects/spectrum/">more about it</a>
    </p>
</Base>

<script>
    import "../scripts/spectrum";
</script>
