---
// /photos/: one picture at a time, picked at random, with a button for another.
// The picture sits in the middle of a frame of fixed height, so the heading and
// the buttons under it stay where they are whatever shape the picture is.
// There are two sets, my photographs and the shitposts, and a switch between
// them. They come from the photos/ folder; see scripts/photos.ts.
import type { GetStaticPaths } from "astro";
import "../../styles/photos.css";
import Base from "../../layouts/Base.astro";
import { formatDate } from "../../lib/posts";
import { photos } from "../../lib/photos";

// A rest route with one fixed path (/photos/), so that the page is not built
// at all until there is a photo to show.
export const getStaticPaths = (() => (photos.length > 0 ? [{ params: { index: undefined } }] : [])) satisfies GetStaticPaths;

const all = photos.map((photo) => ({
    src: `/photos/${photo.file}`,
    width: photo.width,
    height: photo.height,
    color: photo.color,
    set: photo.kind === "shitpost" ? "shitposts" : "photos",
    title: photo.title ?? "",
    caption: photo.caption ?? "",
    taken: photo.taken ? formatDate(new Date(photo.taken)) : "",
}));
// With scripts the page opens on a picture picked at random. Without them it shows this one.
const first = all.find((photo) => photo.set === "photos") ?? all[0]!;
const count = (set: string) => all.filter((photo) => photo.set === set).length;
---

<Base title="photos" description="Photographs by Charlotte.">
    <div class="page-head">
        <h1>photos</h1>
    </div>

    <figure class="photo">
        <div class="photo-frame">
            <img alt="" />
            <noscript>
                <img src={first.src} width={first.width} height={first.height} alt={first.title} style={`background-color:${first.color}`} />
            </noscript>
        </div>
        <figcaption>
            <h2 class="photo-title"><noscript>{first.title}</noscript></h2>
            <p class="photo-caption"><noscript>{first.caption}</noscript></p>
            <p class="photo-taken note"><noscript>{first.taken}</noscript></p>
        </figcaption>
    </figure>

    <p class="photo-buttons" hidden>
        <button type="button" data-step="another">another →</button>
        {
            count("shitposts") > 0 && count("photos") > 0 && (
                <span class="photo-sets">
                    <button type="button" data-set="photos" aria-pressed="true">photos</button>
                    <button type="button" data-set="shitposts" aria-pressed="false">shitposts</button>
                </span>
            )
        }
    </p>

    <script type="application/json" id="photo-list" set:html={JSON.stringify(all)} />
</Base>

<script>
    interface Shown {
        src: string;
        width: number;
        height: number;
        color: string;
        set: string;
        title: string;
        caption: string;
        taken: string;
    }

    const all = JSON.parse(document.getElementById("photo-list")?.textContent ?? "[]") as Shown[];
    const figure = document.querySelector<HTMLElement>(".photo");
    const image = document.querySelector<HTMLImageElement>(".photo-frame > img");
    const buttons = document.querySelector<HTMLElement>(".photo-buttons");
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const LEAVE = 240;

    if (figure && image && buttons && all.length > 0) {
        let set = "photos";
        let waiting: number[] = [];
        let next = -1;
        let busy = false;

        // Every picture in the set comes up once, in a shuffled order, before any repeats.
        const draw = (not: number): number => {
            if (waiting.length === 0) {
                waiting = all.map((_, index) => index).filter((index) => all[index]!.set === set && index !== not);
                for (let index = waiting.length - 1; index > 0; index--) {
                    const other = Math.floor(Math.random() * (index + 1));
                    [waiting[index], waiting[other]] = [waiting[other]!, waiting[index]!];
                }
            }
            return waiting.pop() ?? not;
        };

        // Resolves once the picture is fetched and decoded, so it can be shown whole.
        const ready = (src: string) => {
            const loading = new Image();
            loading.src = src;
            return loading.decode().catch(() => {});
        };
        const pause = (ms: number) => new Promise((done) => setTimeout(done, ms));

        // The old picture fades and drifts out, the new one is put in while nothing
        // shows, and then it fades and settles in with its heading just behind it.
        const show = async (index: number) => {
            if (busy) return;
            busy = true;
            const photo = all[index]!;
            const loaded = ready(photo.src);
            if (image.src && !still) {
                figure.dataset.state = "leaving";
                await pause(LEAVE);
            }
            await loaded;
            figure.dataset.state = "arriving";
            image.style.backgroundColor = photo.color;
            image.width = photo.width;
            image.height = photo.height;
            image.alt = photo.title;
            image.src = photo.src;
            document.querySelector(".photo-title")!.textContent = photo.title;
            document.querySelector(".photo-caption")!.textContent = photo.caption;
            document.querySelector(".photo-taken")!.textContent = photo.taken;
            // Let the starting position take before easing out of it.
            void figure.offsetWidth;
            delete figure.dataset.state;
            // Fetch the one after it now, so "another" never waits on the network.
            next = draw(index);
            void ready(all[next]!.src);
            busy = false;
        };

        buttons.hidden = all.length < 2;
        buttons.addEventListener("click", (event) => {
            const button = (event.target as Element).closest<HTMLElement>("button");
            if (button?.dataset.step) void show(next);
            else if (button?.dataset.set && button.dataset.set !== set && !busy) {
                set = button.dataset.set;
                waiting = [];
                for (const other of buttons.querySelectorAll<HTMLElement>("[data-set]")) other.setAttribute("aria-pressed", String(other.dataset.set === set));
                void show(draw(-1));
            }
        });
        document.addEventListener("keydown", (event) => {
            if (event.key === "ArrowRight" && !event.ctrlKey && !event.metaKey && !event.altKey) void show(next);
        });

        // A different picture every visit.
        figure.dataset.state = "arriving";
        void show(draw(-1));
    }
</script>
