---
// /photos/: one photograph at a time, with a button for another at random.
// They come from the photos/ folder; see scripts/photos.ts.
import type { GetStaticPaths } from "astro";
import "../../styles/photos.css";
import Base from "../../layouts/Base.astro";
import { formatDate } from "../../lib/posts";
import { photos } from "../../lib/photos";

// A rest route with one fixed path (/photos/), so that the page is not built
// at all until there is a photo to show.
export const getStaticPaths = (() => (photos.length > 0 ? [{ params: { index: undefined } }] : [])) satisfies GetStaticPaths;

const all = photos.map((photo) => ({
    src: `/photos/${photo.file}`,
    width: photo.width,
    height: photo.height,
    color: photo.color,
    caption: photo.caption ?? "",
    taken: photo.taken ? formatDate(new Date(photo.taken)) : "",
}));
// Without scripts the page shows this one: the newest.
const first = all[0]!;
---

<Base title="photos" description="Photographs by Charlotte.">
    <div class="page-head">
        <h1>photos</h1>
    </div>

    <figure class="photo">
        <img src={first.src} width={first.width} height={first.height} alt={first.caption} style={`background-color:${first.color}`} fetchpriority="high" />
        <figcaption>
            <p class="photo-caption">{first.caption}</p>
            <p class="photo-taken note">{first.taken}</p>
        </figcaption>
    </figure>

    <p class="photo-buttons" hidden>
        <button type="button" data-step="back" disabled>back</button>
        <button type="button" data-step="another">another</button>
        <span class="note">{all.length} photos</span>
    </p>

    <script type="application/json" id="photo-list" set:html={JSON.stringify(all)} />
</Base>

<script>
    interface Shown {
        src: string;
        width: number;
        height: number;
        color: string;
        caption: string;
        taken: string;
    }

    const all = JSON.parse(document.getElementById("photo-list")?.textContent ?? "[]") as Shown[];
    const image = document.querySelector<HTMLImageElement>(".photo img");
    const buttons = document.querySelector<HTMLElement>(".photo-buttons");
    const back = buttons?.querySelector<HTMLButtonElement>('[data-step="back"]');

    if (image && buttons && back && all.length > 1) {
        buttons.hidden = false;

        // Every photo comes up once, in a shuffled order, before any repeats.
        let waiting: number[] = [];
        const draw = (not: number): number => {
            if (waiting.length === 0) {
                waiting = all.map((_, index) => index).filter((index) => index !== not);
                for (let index = waiting.length - 1; index > 0; index--) {
                    const other = Math.floor(Math.random() * (index + 1));
                    [waiting[index], waiting[other]] = [waiting[other]!, waiting[index]!];
                }
            }
            return waiting.pop()!;
        };

        const seen = [0];
        let next = draw(0);
        // Fetch the one that will come next, so "another" is instant.
        const warm = () => (new Image().src = all[next]!.src);

        const show = (index: number) => {
            const photo = all[index]!;
            image.style.backgroundColor = photo.color;
            image.width = photo.width;
            image.height = photo.height;
            image.alt = photo.caption;
            image.src = photo.src;
            document.querySelector(".photo-caption")!.textContent = photo.caption;
            document.querySelector(".photo-taken")!.textContent = photo.taken;
            back.disabled = seen.length < 2;
        };

        const step = (kind: string) => {
            if (kind === "back") {
                if (seen.length < 2) return;
                seen.pop();
            } else {
                seen.push(next);
                next = draw(next);
                warm();
            }
            show(seen[seen.length - 1]!);
        };

        buttons.addEventListener("click", (event) => {
            const kind = (event.target as Element).closest<HTMLElement>("button[data-step]")?.dataset.step;
            if (kind) step(kind);
        });
        document.addEventListener("keydown", (event) => {
            if (event.ctrlKey || event.metaKey || event.altKey) return;
            if (event.key === "ArrowRight") step("another");
            if (event.key === "ArrowLeft") step("back");
        });
        warm();
    }
</script>
