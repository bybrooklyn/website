---
// /photos/: one picture at a time, picked at random, with a button for another.
// The picture sits in the middle of a frame of fixed height, so the heading and
// the buttons under it stay where they are whatever shape the picture is.
// There are two sets, my photographs and the shitposts, and a switch between
// them. They come from the photos/ folder; see scripts/photos.ts.
import type { GetStaticPaths } from "astro";
import "../../styles/photos.css";
import Base from "../../layouts/Base.astro";
import { formatDate } from "../../lib/posts";
import { photos } from "../../lib/photos";

// A rest route with one fixed path (/photos/), so that the page is not built
// at all until there is a photo to show.
export const getStaticPaths = (() => (photos.length > 0 ? [{ params: { index: undefined } }] : [])) satisfies GetStaticPaths;

// Two sizes of each picture: the browser takes the smaller one on a small screen.
const SMALL_EDGE = 1200;
const sizes = "(max-width: 40rem) 100vw, 80vw";
const all = photos.map((photo) => ({
    src: `/photos/${photo.file}`,
    srcset: `/photos/s/${photo.file} ${Math.min(photo.width, Math.round((photo.width * SMALL_EDGE) / Math.max(photo.width, photo.height)))}w, /photos/${photo.file} ${photo.width}w`,
    width: photo.width,
    height: photo.height,
    color: photo.color,
    set: photo.kind === "shitpost" ? "shitposts" : "photos",
    title: photo.title ?? "",
    caption: photo.caption ?? "",
    // under a friend's photograph: who took it, then when
    taken: [photo.by && `by ${photo.by}`, photo.taken && formatDate(new Date(photo.taken))].filter(Boolean).join(" · "),
}));
// With scripts the page opens on a picture picked at random. Without them it shows this one.
const first = all.find((photo) => photo.set === "photos") ?? all[0]!;
const count = (set: string) => all.filter((photo) => photo.set === set).length;
---

<Base title="photos" description="Photographs by Charlotte.">
    <div class="page-head">
        <h1>photos</h1>
    </div>

    <figure class="photo" data-sizes={sizes}>
        <div class="photo-frame">
            <img alt="" />
            <noscript>
                <img src={first.src} srcset={first.srcset} {sizes} width={first.width} height={first.height} alt={first.title} style={`background-color:${first.color}`} />
            </noscript>
        </div>
        <figcaption aria-live="polite">
            <h2 class="photo-title"><noscript>{first.title}</noscript></h2>
            <p class="photo-caption"><noscript>{first.caption}</noscript></p>
            <p class="photo-taken note"><noscript>{first.taken}</noscript></p>
        </figcaption>
    </figure>

    <p class="photo-buttons" hidden>
        <button type="button" data-step="another">another →</button>
        {
            count("shitposts") > 0 && count("photos") > 0 && (
                <span class="photo-sets">
                    <button type="button" data-set="photos" aria-pressed="true">photos</button>
                    <button type="button" data-set="shitposts" aria-pressed="false">shitposts</button>
                </span>
            )
        }
    </p>

    {/* "<" written as <, so that a title holding "</script>" cannot end the list early */}
    <script type="application/json" id="photo-list" set:html={JSON.stringify(all).replace(/</g, "\\u003c")} />
</Base>

<script>
    import { still } from "../../scripts/opening";

    interface Shown {
        src: string;
        srcset: string;
        width: number;
        height: number;
        color: string;
        set: string;
        title: string;
        caption: string;
        taken: string;
    }

    const all = JSON.parse(document.getElementById("photo-list")?.textContent ?? "[]") as Shown[];
    const figure = document.querySelector<HTMLElement>(".photo");
    const image = document.querySelector<HTMLImageElement>(".photo-frame > img");
    const buttons = document.querySelector<HTMLElement>(".photo-buttons");
    const LEAVE = 240;
    // One clear pixel, standing in for a picture that has not arrived.
    const BLANK = "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";

    if (figure && image && buttons && all.length > 0) {
        let set = "photos";
        let waiting: number[] = [];
        let next = -1;
        let busy = false;

        // Every picture in the set comes up once, in a shuffled order, before any repeats. The order
        // still to come is kept in the browser between visits, so that coming back carries on through
        // the pictures not yet seen and does not start again on ones seen last time.
        const kept = () => `photos-to-come-${set}`;
        const recall = (not: number): number[] => {
            try {
                const names = JSON.parse(localStorage.getItem(kept()) ?? "[]") as string[];
                return names.map((name) => all.findIndex((photo) => photo.src === name && photo.set === set)).filter((index) => index >= 0 && index !== not);
            } catch {
                return [];
            }
        };
        // The picture fetched ahead as the next one has not been seen yet, so it is kept as the
        // first to come (the list is taken from its end).
        const keep = () => {
            const toCome = next >= 0 && all[next]!.set === set ? [...waiting, next] : waiting;
            try {
                localStorage.setItem(kept(), JSON.stringify(toCome.map((index) => all[index]!.src)));
            } catch {
                // without storage each visit is shuffled afresh, as before
            }
        };
        const draw = (not: number): number => {
            if (waiting.length === 0) waiting = recall(not);
            if (waiting.length === 0) {
                waiting = all.map((_, index) => index).filter((index) => all[index]!.set === set && index !== not);
                for (let index = waiting.length - 1; index > 0; index--) {
                    const other = Math.floor(Math.random() * (index + 1));
                    [waiting[index], waiting[other]] = [waiting[other]!, waiting[index]!];
                }
            }
            return waiting.pop() ?? not;
        };

        // Resolves once the picture is fetched and decoded, so it can be shown whole: true if it
        // came, false if it is not there to be had (a page left open since before a picture was
        // taken off the site still lists it). It asks for the same size the page will, so the two
        // share one download.
        const sizes = figure.dataset.sizes ?? "100vw";
        const ready = async (photo: Shown): Promise<boolean> => {
            const loading = new Image();
            const came = new Promise<boolean>((done) => {
                loading.onload = () => done(true);
                loading.onerror = () => done(false);
            });
            loading.sizes = sizes;
            loading.srcset = photo.srcset;
            loading.src = photo.src;
            if (!(await came)) return false;
            try {
                await loading.decode();
            } catch {
                // A picture that will not decode is shown as it is.
            }
            return true;
        };
        /** How many pictures in a row have not been there. After a few the page stops looking. */
        let missing = 0;
        const pause = (ms: number) => new Promise((done) => setTimeout(done, ms));

        // The old picture fades and drifts out, the new one is put in while nothing
        // shows, and then it fades and settles in with its heading just behind it.
        /** A set asked for while a picture is still changing, and how a set is switched to. */
        let later: string | undefined;
        let pick: (name: string) => void = () => {};
        const show = async (index: number) => {
            if (busy) return;
            busy = true;
            const photo = all[index]!;
            const loaded = ready(photo);
            // a picture that is not there is passed over for another, without a hole being shown
            const pass = () => {
                busy = false;
                if (++missing <= 5) void show(draw(index));
                // giving up: the figure comes back as it was, not left faded out
                else delete figure.dataset.state;
            };
            if (image.src && !still.matches) {
                figure.dataset.state = "leaving";
                await pause(LEAVE);
            }
            // A picture that is slow to arrive is not waited for: its place is shown at
            // once, in its shape and main color, and the picture fills it when it comes.
            const here = await Promise.race([loaded.then((came) => (came ? "here" : "gone")), pause(image.src ? 150 : 0).then(() => "late")]);
            if (here === "gone") return pass();
            figure.dataset.state = "arriving";
            image.style.backgroundColor = photo.color;
            image.style.setProperty("--shape", `${photo.width} / ${photo.height}`);
            image.width = photo.width;
            image.height = photo.height;
            image.alt = photo.title;
            const put = () => {
                image.classList.remove("waiting");
                image.sizes = sizes;
                image.srcset = photo.srcset;
                image.src = photo.src;
            };
            if (here === "here") {
                missing = 0;
                put();
            } else {
                image.classList.add("waiting");
                image.removeAttribute("srcset");
                image.src = BLANK;
                void loaded.then((came) => {
                    if (image.alt !== photo.title || !image.classList.contains("waiting")) return;
                    if (came) {
                        missing = 0;
                        put();
                    } else if (!busy) pass();
                });
            }
            document.querySelector(".photo-title")!.textContent = photo.title;
            document.querySelector(".photo-caption")!.textContent = photo.caption;
            document.querySelector(".photo-taken")!.textContent = photo.taken;
            // Let the starting position take before easing out of it.
            void figure.offsetWidth;
            delete figure.dataset.state;
            // Fetch the one after it now, so "another" never waits on the network.
            next = draw(index);
            keep();
            void ready(all[next]!);
            busy = false;
            // a set asked for while a picture was changing is switched to now, not forgotten
            if (later) {
                const name = later;
                later = undefined;
                pick(name);
            }
        };

        buttons.hidden = all.length < 2;
        buttons.addEventListener("click", (event) => {
            const button = (event.target as Element).closest<HTMLElement>("button");
            if (button?.dataset.step) void show(next);
            else if (button?.dataset.set && button.dataset.set !== set) {
                if (busy) later = button.dataset.set;
                else pick(button.dataset.set);
            }
        });
        pick = (name) => {
            set = name;
            waiting = [];
            for (const other of buttons.querySelectorAll<HTMLElement>("[data-set]")) other.setAttribute("aria-pressed", String(other.dataset.set === set));
            void show(draw(-1));
        };
        document.addEventListener("keydown", (event) => {
            if (event.key === "ArrowRight" && !event.ctrlKey && !event.metaKey && !event.altKey) void show(next);
        });

        // A different picture every visit.
        figure.dataset.state = "arriving";
        void show(draw(-1));
    }
</script>
