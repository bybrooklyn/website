---
// /photos/: photographs, sorted under headings by what is in them, newest
// first. Clicking one opens it large. They come from the photos/ folder; see
// scripts/photos.ts.
import Picture from "../../components/Picture.astro";
import { getImage } from "astro:assets";
import type { GetStaticPaths } from "astro";
import "../../styles/photos.css";
import Base from "../../layouts/Base.astro";
import { formatDate } from "../../lib/posts";
import { groups, photos } from "../../lib/photos";

// A rest route with one fixed path (/photos/), so that the page is not built
// at all until there is a photo to show.
export const getStaticPaths = (() => (photos.length > 0 ? [{ params: { index: undefined } }] : [])) satisfies GetStaticPaths;

const shown = await Promise.all(
    groups.map(async (group) => ({
        title: group.title,
        photos: await Promise.all(
            group.photos.map(async (photo) => ({
                photo,
                large: await getImage({ src: photo.image, width: Math.min(photo.image.width, 2000), format: "avif" }),
                taken: photo.taken ? formatDate(new Date(photo.taken)) : "",
            })),
        ),
    })),
);
---

<Base title="photos" description="Photographs by Charlotte.">
    <div class="page-head">
        <h1>photos</h1>
    </div>

    {
        shown.map((group) => (
            <section class="album">
                {group.title && <h2>{group.title}</h2>}
                <ul class="photo-grid">
                    {group.photos.map(({ photo, large, taken }) => (
                        <li>
                            <a href={large.src} data-caption={photo.caption ?? ""} data-taken={taken}>
                                <Picture
                                    src={photo.image}
                                    alt={photo.caption ?? ""}
                                    widths={[480, 960]}
                                    sizes="(min-width: 60rem) 22rem, (min-width: 36rem) 50vw, 100vw"
                                />
                            </a>
                        </li>
                    ))}
                </ul>
            </section>
        ))
    }

    <dialog class="photo-view" aria-label="Photo">
        <img alt="" />
        <p class="photo-caption"></p>
        <p class="photo-taken note"></p>
        <form method="dialog"><button aria-label="Close">close</button></form>
    </dialog>
</Base>

<script>
    const view = document.querySelector<HTMLDialogElement>(".photo-view");
    const links = [...document.querySelectorAll<HTMLAnchorElement>(".photo-grid a")];
    const image = view?.querySelector("img");
    let open = -1;

    function show(link: HTMLAnchorElement | undefined): void {
        if (!view || !image || !link) return;
        open = links.indexOf(link);
        image.src = link.href;
        image.alt = link.dataset.caption ?? "";
        view.querySelector(".photo-caption")!.textContent = link.dataset.caption ?? "";
        view.querySelector(".photo-taken")!.textContent = link.dataset.taken ?? "";
        if (!view.open) view.showModal();
    }

    for (const link of links) {
        link.addEventListener("click", (event) => {
            if (event.ctrlKey || event.metaKey || event.shiftKey) return;
            event.preventDefault();
            show(link);
        });
    }

    view?.addEventListener("keydown", (event) => {
        const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key];
        if (step) show(links[open + step]);
    });
    // A click on the backdrop closes it.
    view?.addEventListener("click", (event) => {
        if (event.target === view) view.close();
    });
</script>
