        stroke: var(--accent);
        stroke-width: 1.4;
        stroke-linejoin: round;
    }

    @media (hover: hover) {
        .sheet-die:hover {
            border-color: var(--accent);
        }
    }

    .sheet-die:active {
        scale: 0.94;
        transition-duration: 0.15s, 0.08s;
    }

    .sheet-rolls {
        margin: 0;
