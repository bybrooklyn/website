    }

    /* where the canvas would be: a few lines to say so */
    .sheet-view {
        display: grid;
        align-items: end;
        min-height: 12rem;
        padding: 1rem 1rem 0;
    }

    .sheet-view svg {
        width: 100%;
        max-height: 14rem;
        fill: none;
        stroke: var(--rule);
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .sheet-view text {
        fill: var(--muted);
        stroke: none;
        font-family: var(--font-code);
        font-size: 11px;
        text-anchor: middle;
    }

    .sheet-view .sheet-body {
        fill: color-mix(in oklch, var(--accent) 70%, var(--ground));
        stroke: none;
    }

    .sheet-view .sheet-legs {
        stroke: var(--ink);
        stroke-width: 7;
        opacity: 0.85;
    }

    .sheet-dice-picks {
        gap: 0.5rem;
        padding-top: 0.5rem;
    }

    /* the Dice mini's own tile for a die: kept as it is, with the set's badge on its corner */
    .sheet-die {
        position: relative;
        display: grid;
        justify-items: center;
        gap: 0.2rem;
