        border-bottom: 0.0625rem solid var(--rule);
    }

    .specimen {
        display: grid;
        grid-template-columns: minmax(0, 16rem) minmax(0, 1fr);
        gap: 0.75rem 2.5rem;
        padding: calc(var(--line) * 0.9) 0;
        border-bottom: 0.0625rem solid color-mix(in oklch, var(--rule) 55%, transparent);
    }

    .specimen:last-child {
        border-bottom: 0;
    }

    .specimen-about h3 {
        margin: 0;
