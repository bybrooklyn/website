---
// /controls/: the site's controls, each in every state, to be judged before they are used everywhere. Unlisted,
// not in the menu and kept out of the sitemap (astro.config.ts). The set itself is src/styles/controls.css and
// src/scripts/controls.ts. The two worked examples at the end are still copies of the Dice and Walker minis'
// panels, built only from the set and not wired to the minis.
//
// Hover, pressed and focus are shown standing still by the script at the end of the page, which copies each
// such rule of the site's stylesheets onto a class (.is-hover, .is-pressed, .is-focus).
import "../styles/controls.css";
import Base from "../layouts/Base.astro";

const dice = [
    { sides: 4, shape: "12,3 21,20 3,20" },
    { sides: 6, shape: "4,4 20,4 20,20 4,20" },
    { sides: 8, shape: "12,2 22,12 12,22 2,12" },
    { sides: 10, shape: "12,2 21,10 12,22 3,10" },
    { sides: 12, shape: "12,2 21.5,9 18,21 6,21 2.5,9" },
    { sides: 20, shape: "12,2 21,7 21,17 12,22 3,17 3,7" },
    { sides: 100, shape: "12,2 21,10 12,22 3,10" },
];
const hand: Record<number, number> = { 6: 2, 20: 1 };
---

<Base title="controls" description="The site's controls, each in every state." unlisted>
    <div class="page-head">
        <h1>controls</h1>
        <p class="lede">One set of controls for the whole site: one height, one corner, one size of words, one ring. Each kind in every state, then two minis' panels made of nothing else.</p>
        <p class="sheet-numbers note">
            <span>height <strong>2.25rem</strong></span>
            <span>corner <strong>0.625rem</strong></span>
            <span>words <strong>1rem</strong>, labels <strong>0.875rem</strong></span>
            <span>ring <strong>the site's</strong></span>
            <span>motion <strong>--ease</strong>, opening <strong>--spring</strong></span>
        </p>
    </div>

    <section class="sheet-section">
        <h2>buttons</h2>

        <div class="specimen">
            <div class="specimen-about">
                <h3>button</h3>
                <p>The main thing a group does: roll, drop, copy. One to a group.</p>
            </div>
            <div class="specimen-states">
                <figure><button type="button" class="button">roll</button><figcaption>rest</figcaption></figure>
                <figure><button type="button" class="button is-hover">roll</button><figcaption>hover</figcaption></figure>
                <figure><button type="button" class="button is-pressed">roll</button><figcaption>pressed</figcaption></figure>
                <figure><button type="button" class="button is-focus">roll</button><figcaption>keyboard</figcaption></figure>
                <figure><button type="button" class="button" disabled>roll</button><figcaption>not now</figcaption></figure>
                <figure><button type="button" class="button" aria-busy="true">roll</button><figcaption>busy</figcaption></figure>
                <figure><button type="button" class="button" data-try="busy">copy link</button><figcaption>press it</figcaption></figure>
            </div>
        </div>

        <div class="specimen">
            <div class="specimen-about">
                <h3>quiet button</h3>
                <p>Everything else a group can do: clear, copy a link, start over.</p>
            </div>
            <div class="specimen-states">
                <figure><button type="button" class="button quiet">clear</button><figcaption>rest</figcaption></figure>
                <figure><button type="button" class="button quiet is-hover">clear</button><figcaption>hover</figcaption></figure>
                <figure><button type="button" class="button quiet is-pressed">clear</button><figcaption>pressed</figcaption></figure>
                <figure><button type="button" class="button quiet is-focus">clear</button><figcaption>keyboard</figcaption></figure>
                <figure><button type="button" class="button quiet" disabled>clear</button><figcaption>not now</figcaption></figure>
                <figure><button type="button" class="button quiet" aria-busy="true">clear</button><figcaption>busy</figcaption></figure>
                <figure><button type="button" class="button quiet" data-try="copied">copy link to this roll</button><figcaption>press it</figcaption></figure>
            </div>
        </div>

        <div class="specimen">
            <div class="specimen-about">
                <h3>icon button</h3>
                <p>A picture with no words, where room is short, as in the terminal's bar. It has a name for screen readers and a tooltip.</p>
            </div>
            <div class="specimen-states">
                {
                    [
                        ["", "rest"],
                        ["is-hover", "hover"],
                        ["is-pressed", "pressed"],
                        ["is-focus", "keyboard"],
                        ["disabled", "not now"],
                        ["busy", "busy"],
                    ].map(([state, caption]) => (
                        <figure>
                            <button type="button" class={`button icon ${state === "disabled" || state === "busy" ? "" : state}`} aria-label="Play again" disabled={state === "disabled"} aria-busy={state === "busy" ? "true" : undefined}>
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7" /><path d="M4 4v4.5h4.5" /></svg>
                            </button>
                            <figcaption>{caption}</figcaption>
                        </figure>
                    ))
                }
                <figure>
                    <span class="control-row sheet-tight">
                        <button type="button" class="button icon" aria-label="Play again"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7" /><path d="M4 4v4.5h4.5" /></svg></button>
                        <button type="button" class="button icon" aria-label="Open it to the whole window"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg></button>
                        <button type="button" class="button icon" aria-label="Close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg></button>
                    </span>
                    <figcaption>a bar of them</figcaption>
                </figure>
            </div>
        </div>
    </section>

    <section class="sheet-section">
        <h2>links that act</h2>

        <div class="specimen">
            <div class="specimen-about">
                <h3>action link</h3>
                <p>Going somewhere: all posts, all minis, another picture. The arrow leans the way it points when touched.</p>
            </div>
            <div class="specimen-states">
                <figure><a class="action-link" href="#links">all posts</a><figcaption>rest</figcaption></figure>
                <figure><a class="action-link is-hover" href="#links">all posts</a><figcaption>hover</figcaption></figure>
                <figure><a class="action-link is-pressed" href="#links">all posts</a><figcaption>pressed</figcaption></figure>
                <figure><a class="action-link is-focus" href="#links">all posts</a><figcaption>keyboard</figcaption></figure>
                <figure><a class="action-link" aria-disabled="true">all posts</a><figcaption>not now</figcaption></figure>
                <figure><button type="button" class="action-link" aria-busy="true">another</button><figcaption>busy</figcaption></figure>
            </div>
        </div>

        <div class="specimen" id="links">
            <div class="specimen-about">
                <h3>action link, here</h3>
                <p>Starting something in place, as the demo's play line does: a triangle before it instead of an arrow after.</p>
            </div>
            <div class="specimen-states">
                <figure><button type="button" class="action-link here">play the demo</button><figcaption>rest</figcaption></figure>
                <figure><button type="button" class="action-link here is-hover">play the demo</button><figcaption>hover</figcaption></figure>
                <figure><button type="button" class="action-link here is-pressed">play the demo</button><figcaption>pressed</figcaption></figure>
                <figure><button type="button" class="action-link here" disabled>play the demo</button><figcaption>not now</figcaption></figure>
            </div>
        </div>
    </section>

    <section class="sheet-section">
        <h2>choosing</h2>

        <div class="specimen">
            <div class="specimen-about">
                <h3>pill switch</h3>
                <p>One of a few, all in sight. The marker slides to a new choice, and is still otherwise. The arrow keys move it.</p>
            </div>
            <div class="specimen-states">
                <figure>
                    <div class="choice" role="radiogroup" aria-label="Ground" data-measure="choice">
                        {["flat", "hills", "steps", "gaps"].map((kind, index) => <label><input type="radio" name="ground-a" value={kind} checked={index === 0} /><span>{kind}</span></label>)}
                    </div>
                    <figcaption>rest, and try it</figcaption>
                </figure>
                <figure>
                    <div class="choice" role="radiogroup" aria-label="Ground">
                        {["flat", "hills", "steps", "gaps"].map((kind, index) => <label class={index === 2 ? "is-hover" : ""}><input type="radio" name="ground-b" value={kind} checked={index === 1} /><span>{kind}</span></label>)}
                    </div>
                    <figcaption>hover on steps</figcaption>
                </figure>
                <figure>
                    <div class="choice" role="radiogroup" aria-label="Ground">
                        {["flat", "hills", "steps", "gaps"].map((kind, index) => <label class={index === 3 ? "is-pressed" : ""}><input type="radio" name="ground-c" value={kind} checked={index === 1} /><span>{kind}</span></label>)}
                    </div>
                    <figcaption>pressing gaps</figcaption>
                </figure>
                <figure>
                    <div class="choice" role="radiogroup" aria-label="Ground">
                        {["flat", "hills", "steps", "gaps"].map((kind, index) => <label><input type="radio" name="ground-d" value={kind} checked={index === 2} class={index === 2 ? "is-focus" : ""} /><span>{kind}</span></label>)}
                    </div>
                    <figcaption>keyboard</figcaption>
                </figure>
                <figure>
                    <div class="choice" role="radiogroup" aria-label="Ground">
                        {["flat", "hills", "steps", "gaps"].map((kind, index) => <label><input type="radio" name="ground-e" value={kind} checked={index === 0} disabled /><span>{kind}</span></label>)}
                    </div>
                    <figcaption>not now</figcaption>
                </figure>
                <figure class="sheet-narrow">
                    <div class="choice fill" role="radiogroup" aria-label="Legs">
                        {[1, 2, 4].map((legs) => <label><input type="radio" name="legs-a" value={legs} checked={legs === 2} /><span>{legs}</span></label>)}
                    </div>
                    <figcaption>filling its width</figcaption>
                </figure>
            </div>
        </div>

        <div class="specimen">
            <div class="specimen-about">
                <h3>checkbox</h3>
                <p>Each of several things on or off, such as what to show.</p>
            </div>
            <div class="specimen-states">
                <figure><label class="check"><input type="checkbox" /> the crowd</label><figcaption>off</figcaption></figure>
                <figure><label class="check"><input type="checkbox" checked /> the crowd</label><figcaption>on</figcaption></figure>
                <figure><label class="check is-hover"><input type="checkbox" /> the crowd</label><figcaption>hover</figcaption></figure>
                <figure><label class="check is-pressed"><input type="checkbox" checked /> the crowd</label><figcaption>pressed</figcaption></figure>
                <figure><label class="check"><input type="checkbox" class="is-focus" checked /> the crowd</label><figcaption>keyboard</figcaption></figure>
                <figure><label class="check"><input type="checkbox" disabled checked /> the crowd</label><figcaption>not now</figcaption></figure>
            </div>
        </div>

        <div class="specimen">
            <div class="specimen-about">
                <h3>toggle</h3>
                <p>One thing on or off that takes effect at once, such as sound.</p>
            </div>
            <div class="specimen-states">
                <figure><label class="toggle"><input type="checkbox" role="switch" /> sound</label><figcaption>off</figcaption></figure>
                <figure><label class="toggle"><input type="checkbox" role="switch" checked /> sound</label><figcaption>on</figcaption></figure>
                <figure><label class="toggle is-hover"><input type="checkbox" role="switch" /> sound</label><figcaption>hover</figcaption></figure>
                <figure><label class="toggle is-pressed"><input type="checkbox" role="switch" /> sound</label><figcaption>pressed</figcaption></figure>
                <figure><label class="toggle"><input type="checkbox" role="switch" class="is-focus" checked /> sound</label><figcaption>keyboard</figcaption></figure>
                <figure><label class="toggle"><input type="checkbox" role="switch" disabled /> sound</label><figcaption>not now</figcaption></figure>
            </div>
        </div>

        <div class="specimen">
            <div class="specimen-about">
                <h3>slider</h3>
                <p>A number in a range, with the number beside it.</p>
            </div>
            <div class="specimen-states sheet-sliders">
                <figure><label class="slider"><span>how rough</span><input type="range" min="0" max="100" step="5" value="40" /><output>40</output></label><figcaption>rest, and try it</figcaption></figure>
                <figure><label class="slider"><span>bounce</span><input type="range" min="0" max="1" step="0.05" value="0.6" class="is-hover" /><output>0.6</output></label><figcaption>hover</figcaption></figure>
                <figure><label class="slider"><span>rows</span><input type="range" min="4" max="16" value="9" class="is-pressed" /><output>9</output></label><figcaption>held</figcaption></figure>
                <figure><label class="slider"><span>gravity</span><input type="range" min="0" max="2" step="0.1" value="1" class="is-focus" /><output>1</output></label><figcaption>keyboard</figcaption></figure>
                <figure><label class="slider"><span>length</span><input type="range" min="4" max="64" value="20" disabled /><output>20</output></label><figcaption>not now</figcaption></figure>
            </div>
        </div>
    </section>

    <section class="sheet-section">
        <h2>typing</h2>

        <div class="specimen">
            <div class="specimen-about">
                <h3>text field</h3>
                <p>A line to type into.</p>
            </div>
            <div class="specimen-states">
                <figure><input class="field" type="text" placeholder="2d6+3, d20 adv" aria-label="A roll" /><figcaption>empty</figcaption></figure>
                <figure><input class="field" type="text" value="2d6 + d20" aria-label="A roll" /><figcaption>written in</figcaption></figure>
                <figure><input class="field is-hover" type="text" placeholder="2d6+3, d20 adv" aria-label="A roll" /><figcaption>hover</figcaption></figure>
                <figure><input class="field is-focus" type="text" value="2d6 + d20" aria-label="A roll" data-focus /><figcaption>typing</figcaption></figure>
                <figure><input class="field" type="text" placeholder="2d6+3, d20 adv" aria-label="A roll" disabled /><figcaption>not now</figcaption></figure>
            </div>
        </div>

        <div class="specimen">
            <div class="specimen-about">
                <h3>field with a button</h3>
                <p>A line to type into, and the one thing to do with it.</p>
            </div>
            <div class="specimen-states">
                <figure class="sheet-wide">
                    <form class="field-with-button" data-try="field">
                        <input class="field" type="text" placeholder="2d6+3, d20 adv" aria-label="The roll to make" />
                        <button type="submit" class="button">roll</button>
                    </form>
                    <figcaption>rest, and try it</figcaption>
                </figure>
                <figure class="sheet-wide">
                    <div class="field-with-button">
                        <input class="field code" type="text" value="bybrooklyn.dev/spectrum/?c=5a5" aria-label="The link" readonly />
                        <button type="button" class="button is-hover">copy</button>
                    </div>
                    <figcaption>a link to copy, button hovered</figcaption>
                </figure>
            </div>
        </div>
    </section>

    <section class="sheet-section">
        <h2>saying</h2>

        <div class="specimen">
            <div class="specimen-about">
                <h3>count badge</h3>
                <p>How many, on what it counts. It grows in at one and shrinks away at none.</p>
            </div>
            <div class="specimen-states">
                <figure><span class="badge">2</span><figcaption>alone</figcaption></figure>
                <figure><span class="badge">12</span><figcaption>more</figcaption></figure>
                <figure>
                    <span class="control-row sheet-tight">
                        <span class="sheet-counted"><button type="button" class="button quiet" data-try="count">add a d6</button><span class="badge corner appears" data-count>0</span></span>
                        <button type="button" class="button quiet" data-try="uncount">clear</button>
                    </span>
                    <figcaption>try it</figcaption>
                </figure>
            </div>
        </div>

        <div class="specimen">
            <div class="specimen-about">
                <h3>status line</h3>
                <p>What is happening, in a sentence. It changes without moving anything under it.</p>
            </div>
            <div class="specimen-states">
                <figure class="sheet-wide">
                    <p class="status" aria-live="polite" data-status>Generation <strong>39</strong>. The best has walked <strong>11.5</strong> m.</p>
                    <figcaption>rest</figcaption>
                </figure>
                <figure>
                    <button type="button" class="button quiet" data-try="say">say something else</button>
                    <figcaption>try it</figcaption>
                </figure>
            </div>
        </div>

        <div class="specimen">
            <div class="specimen-about">
                <h3>tooltip</h3>
                <p>The name of something that shows no words. After half a second's rest, or at once by keyboard.</p>
            </div>
            <div class="specimen-states sheet-tips">
                <figure>
                    <span class="has-tooltip">
                        <button type="button" class="button icon" aria-describedby="tip-a" aria-label="Play again"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7" /><path d="M4 4v4.5h4.5" /></svg></button>
                        <span class="tooltip" role="tooltip" id="tip-a">play again</span>
                    </span>
                    <figcaption>rest, and try it</figcaption>
                </figure>
                <figure>
                    <span class="has-tooltip">
                        <button type="button" class="button icon is-hover" aria-describedby="tip-b" aria-label="Open it to the whole window"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg></button>
                        <span class="tooltip shown" role="tooltip" id="tip-b">whole window</span>
                    </span>
                    <figcaption>shown</figcaption>
                </figure>
            </div>
        </div>
    </section>

    <section class="sheet-section">
        <h2>menus</h2>

        <div class="specimen">
            <div class="specimen-about">
                <h3>menu</h3>
                <p>A few things to do that need not always show. It flows open from its button and its items arrive one after another. The arrows move through it; Escape closes it.</p>
            </div>
            <div class="specimen-states sheet-menus">
                <figure>
                    <div class="menu" data-menu>
                        <div class="menu-box">
                            <button type="button" class="menu-button">share<i class="menu-turn" aria-hidden="true"></i></button>
                            <div class="menu-items" role="menu" aria-label="Share">
                                <button type="button" role="menuitem">copy link to this walker</button>
                                <button type="button" role="menuitem">copy the brain</button>
                                <button type="button" role="menuitem" aria-disabled="true">download a recording</button>
                            </div>
                        </div>
                    </div>
                    <figcaption>with words</figcaption>
                </figure>
                <figure>
                    <div class="menu dots" data-menu>
                        <div class="menu-box">
                            <button type="button" class="menu-button" aria-label="More about this picture"><span class="menu-dots" aria-hidden="true"><i></i><i></i><i></i></span></button>
                            <div class="menu-items" role="menu" aria-label="More about this picture">
                                <a href="#menus" role="menuitem">Open in a new tab</a>
                                <a href="#menus" role="menuitem">Download</a>
                                <a href="#menus" role="menuitem">What you may do with it</a>
                            </div>
                        </div>
                    </div>
                    <figcaption>the viewer's dots</figcaption>
                </figure>
                <figure>
                    <div class="menu" data-menu>
                        <div class="menu-box">
                            <button type="button" class="menu-button" disabled>share<i class="menu-turn" aria-hidden="true"></i></button>
                            <div class="menu-items" role="menu" aria-label="Share">
                                <button type="button" role="menuitem">copy link</button>
                            </div>
                        </div>
                    </div>
                    <figcaption>not now</figcaption>
                </figure>
            </div>
        </div>
    </section>

    <section class="sheet-section">
        <h2>coming and going</h2>

        <div class="specimen">
            <div class="specimen-about">
                <h3>appearing</h3>
                <p>The one way anything that is not always there comes and goes: it grows from half its size, and shrinks back.</p>
            </div>
            <div class="specimen-states">
                <figure>
                    <span class="control-row">
                        <label class="toggle"><input type="checkbox" role="switch" data-try="appear" checked /> learning paused</label>
                        <button type="button" class="button appears shown" data-appears>resume learning</button>
                    </span>
                    <figcaption>try it</figcaption>
                </figure>
            </div>
        </div>

        <div class="specimen">
            <div class="specimen-about">
                <h3>panel</h3>
                <p>Controls that belong together, each group under a small label. A row for along the bottom, a column for the side.</p>
            </div>
            <div class="specimen-states sheet-panels">
                <div class="control-panel">
                    <div class="control-group">
                        <p class="control-label">a row</p>
                        <div class="control-row">
                            <button type="button" class="button">drop</button>
                            <button type="button" class="button quiet">copy</button>
                            <label class="toggle"><input type="checkbox" role="switch" /> sound</label>
                        </div>
                    </div>
                    <div class="control-group inline">
                        <p class="control-label">a label beside</p>
                        <div class="choice" role="radiogroup" aria-label="Kind">
                            {["a to z", "0 to 9"].map((kind, index) => <label><input type="radio" name="kind-a" value={kind} checked={index === 0} /><span>{kind}</span></label>)}
                        </div>
                    </div>
                </div>
                <div class="control-panel sheet-column">
                    <div class="control-group">
                        <p class="control-label">a column</p>
                        <div class="control-column">
                            <button type="button" class="button">pause learning</button>
                            <button type="button" class="button quiet">start over</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="sheet-section">
        <h2>in use</h2>
        <p class="sheet-intro">Still copies of two minis' controls, made only from the set above. They answer to the pointer and the keys, and do nothing else.</p>

        <h3 class="sheet-example-name">Dice: the panel under the tower</h3>
        <div class="control-stage sheet-dice">
            <div class="stage-view sheet-view" aria-hidden="true">
                <svg viewBox="0 0 400 160" preserveAspectRatio="xMidYMax meet"><path d="M170 150V18h56v132" /><path d="M176 48l44 22M220 92l-44 22" /><path d="M120 136v14h190v-14" /></svg>
            </div>
            <div class="control-panel bottom">
                <p class="status" aria-live="polite">Pick dice, or type a roll, and send them down the tower.</p>
                <div class="control-row sheet-dice-picks">
                    {
                        dice.map(({ sides, shape }) => (
                            <button type="button" class="sheet-die" aria-label={`Add a d${sides}`}>
                                <svg viewBox="0 0 24 24" aria-hidden="true"><polygon points={shape} /></svg>
                                <span>d{sides}</span>
                                <span class:list={["badge corner appears", { shown: hand[sides] }]}>{hand[sides] ?? 1}</span>
                            </button>
                        ))
                    }
                </div>
                <div class="control-row">
                    <form class="field-with-button grow" data-try="field">
                        <input class="field" type="text" value="2d6 + d20" placeholder="2d6+3, d20 adv" aria-label="The roll to make" />
                        <button type="submit" class="button">roll</button>
                    </form>
                    <button type="button" class="button quiet">clear</button>
                </div>
                <div class="control-row">
                    <button type="button" class="button quiet flush" data-try="copied">copy link to this roll</button>
                    <label class="toggle"><input type="checkbox" role="switch" /> sound</label>
                </div>
                <div class="control-group">
                    <p class="control-label">rolls</p>
                    <ol class="sheet-rolls">
                        <li><strong>17</strong> 2d6 + d20 <span class="note">(4, 2) + 11</span></li>
                        <li><strong>9</strong> 2d6+3 <span class="note">(1, 5) + 3</span></li>
                    </ol>
                </div>
            </div>
        </div>

        <h3 class="sheet-example-name">Walker: the ground along the bottom, the rest at the side</h3>
        <div class="control-stage sheet-walker">
            <div class="stage-view sheet-view" aria-hidden="true">
                <svg viewBox="0 0 480 220" preserveAspectRatio="xMidYMax meet"><path d="M0 190h480" /><path d="M40 190v6M140 190v6M240 190v6M340 190v6M440 190v6" /><rect x="200" y="160" width="48" height="16" rx="6" class="sheet-body" /><path d="M214 160l-6-40l30-12M234 160l4-34l28 2" class="sheet-legs" /><text x="240" y="212">start</text></svg>
            </div>
            <div class="control-panel bottom">
                <div class="control-row">
                    <div class="control-group inline">
                        <p class="control-label" id="walker-ground">ground</p>
                        <div class="choice" role="radiogroup" aria-labelledby="walker-ground">
                            {["flat", "hills", "steps", "gaps"].map((kind, index) => <label><input type="radio" name="walker-ground" value={kind} checked={index === 0} /><span>{kind}</span></label>)}
                        </div>
                    </div>
                    <label class="slider grow"><span>how rough</span><input type="range" min="0" max="100" step="5" value="40" /><output>40</output></label>
                </div>
            </div>
            <div class="control-panel side">
                <p class="status" aria-live="polite">Generation <strong>39</strong>. The best has walked <strong>11.5</strong> m.</p>
                <div class="control-group">
                    <p class="control-label" id="walker-legs">legs</p>
                    <div class="choice fill" role="radiogroup" aria-labelledby="walker-legs">
                        {[1, 2, 4].map((legs) => <label><input type="radio" name="walker-legs" value={legs} checked={legs === 2} /><span>{legs}</span></label>)}
                    </div>
                </div>
                <div class="control-column">
                    <button type="button" class="button">pause learning</button>
                    <button type="button" class="button quiet">start over</button>
                </div>
                <div class="control-group">
                    <p class="control-label">show</p>
                    <div class="sheet-checks">
                        <label class="check"><input type="checkbox" checked /> the crowd</label>
                        <label class="check"><input type="checkbox" checked /> the brain</label>
                    </div>
                </div>
                <button type="button" class="button quiet sheet-share" data-try="copied">copy link to this walker</button>
            </div>
        </div>
    </section>
</Base>

<style>
    /* The sheet's own layout. Nothing here is part of the set. */
    .sheet-numbers {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1.5rem;
        margin: var(--line) 0 0;
    }

    .sheet-numbers strong {
        color: var(--ink);
        font-weight: 500;
    }

    .sheet-section {
        margin-bottom: calc(var(--line) * 2.5);
    }

    .sheet-section > h2 {
        margin: 0 0 calc(var(--line) * 0.5);
