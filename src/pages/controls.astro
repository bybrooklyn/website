</style>

<script>
    import { busy, relabel, say } from "../scripts/controls";

    // Hover, pressed and focus, shown standing still: each rule of the page's stylesheets that answers to
    // one of them is copied onto a class, in a sheet of its own laid over the others.
    const states: [RegExp, string][] = [
        [/:hover/g, ".is-hover"],
        [/:active/g, ".is-pressed"],
        [/:focus-visible/g, ".is-focus"],
        [/:focus(?![-\w])/g, ".is-focus"],
    ];
    const copied: string[] = [];
    const has = (selector: string) => states.some(([state]) => {
        state.lastIndex = 0;
        return state.test(selector);
    });
    /** A list of selectors, split at its own commas and not at those inside :is() and the like. */
    const split = (list: string) => {
        const parts: string[] = [];
        let depth = 0;
        let from = 0;
        [...list].forEach((letter, at) => {
            if (letter === "(") depth++;
            else if (letter === ")") depth--;
            else if (letter === "," && depth === 0) {
                parts.push(list.slice(from, at));
                from = at + 1;
            }
        });
        return [...parts, list.slice(from)].map((part) => part.trim());
    };
    // `within` is the media condition a rule is under, kept on its copy so that a rule for reduced motion stays one
    const walk = (rules: CSSRuleList, within: string[]) => {
        for (const rule of rules) {
            if (rule instanceof CSSStyleRule && has(rule.selectorText)) {
                const selector = split(rule.selectorText)
                    .filter(has)
                    .map((one) => states.reduce((text, [state, name]) => text.replace(state, name), one))
                    .join(", ");
                copied.push(within.reduceRight((inner, condition) => `@media ${condition} { ${inner} }`, `${selector} { ${rule.style.cssText} }`));
            } else if (rule instanceof CSSMediaRule) {
                // shown standing still, a hover needs no pointer that can hover
                const condition = rule.conditionText;
                walk(rule.cssRules, condition === "(hover: hover)" ? within : [...within, condition]);
            } else if (rule instanceof CSSGroupingRule) {
                walk(rule.cssRules, within);
            }
        }
    };
    for (const sheet of document.styleSheets) {
        try {
            walk(sheet.cssRules, []);
        } catch {
            // a sheet from elsewhere cannot be read, and has nothing of the set in it
        }
    }
    const still = new CSSStyleSheet();
    for (const rule of copied) {
        try {
            still.insertRule(rule, still.cssRules.length);
        } catch {
            // a rule for another browser's pseudo-element is not understood here
        }
    }
    document.adoptedStyleSheets = [...document.adoptedStyleSheets, still];

    // the few that do something when tried
    for (const button of document.querySelectorAll<HTMLElement>("[data-try='busy']")) {
        button.addEventListener("click", () => {
            busy(button, true);
            setTimeout(() => {
                busy(button, false);
                relabel(button, "copied");
            }, 1200);
        });
    }
    for (const button of document.querySelectorAll<HTMLElement>("[data-try='copied']")) {
        const words = button.textContent?.includes("walker") ? "link copied" : button.textContent?.includes("roll") ? "link copied" : "copied";
        button.addEventListener("click", () => relabel(button, words));
    }
    for (const form of document.querySelectorAll<HTMLFormElement>("[data-try='field']")) {
        form.addEventListener("submit", (event) => {
            event.preventDefault();
            const button = form.querySelector<HTMLElement>("button")!;
            busy(button, true);
            setTimeout(() => busy(button, false), 900);
        });
    }
    const count = document.querySelector<HTMLElement>("[data-count]");
    let counted = 0;
    document.querySelector("[data-try='count']")?.addEventListener("click", () => {
        counted += 1;
        count!.textContent = String(counted);
        count!.classList.add("shown");
    });
    document.querySelector("[data-try='uncount']")?.addEventListener("click", () => {
        // the number stays while it shrinks away
        counted = 0;
        count!.classList.remove("shown");
    });
    const status = document.querySelector<HTMLElement>("[data-status]");
    const sentences = ["Trying the first generation: 12 of 32.", "Learning is paused at generation 39.", "Generation 40. The best has walked 12.1 m."];
    let said = 0;
    document.querySelector("[data-try='say']")?.addEventListener("click", () => {
        say(status!, sentences[said % sentences.length]!);
        said += 1;
    });
    const appearing = document.querySelector<HTMLElement>("[data-appears]");
    const paused = document.querySelector<HTMLInputElement>("[data-try='appear']");
    paused?.addEventListener("change", () => appearing!.classList.toggle("shown", paused.checked));
    appearing?.addEventListener("click", () => {
        paused!.checked = false;
        appearing.classList.remove("shown");
    });
    // the sheet's dice add to their count, and clear takes the hand away
    for (const die of document.querySelectorAll<HTMLElement>(".sheet-die")) {
        die.addEventListener("click", () => {
            const badge = die.querySelector<HTMLElement>(".badge")!;
            badge.textContent = badge.classList.contains("shown") ? String(Number(badge.textContent) + 1) : "1";
            badge.classList.add("shown");
        });
    }
</script>
