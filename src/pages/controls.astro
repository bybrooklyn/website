    .sheet-narrow .choice {
        width: 100%;
    }

    .sheet-wide {
        flex: 1 1 18rem;
        align-items: stretch !important;
    }

    .sheet-sliders figure {
        width: min(100%, 15rem);
    }

    .sheet-sliders .slider {
