---
import Figure from "../components/Figure.astro";
import PlayHere from "../components/PlayHere.astro";
import LanguageBar from "../components/LanguageBar.astro";
import PostRow from "../components/PostRow.astro";
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { getPosts } from "../lib/posts";

const posts = (await getPosts()).slice(0, 4);
---

<Base>
    <div class="home">
        <div class="hero">
            <section>
                <h1>i'm charlotte</h1>
                <p class="about">{site.about}</p>
            </section>
            <LanguageBar />
        </div>

        <section aria-labelledby="playmatter-title">
            <h2 class="label" id="playmatter-title">playmatter</h2>
            <div class="split feature">
                <PlayHere src="https://itch.io/embed-upload/19697599?color=10091a" title="Playmatter, playable" ratio="16 / 9" label="play the demo here" from="itch.io">
                <Figure
                    src="/assets/playmatter.webp"
                    video="/assets/playmatter.mp4"
                    alt="A car beside a tower of wood, glass, and bricks in Playmatter."
                    width={960}
                    height={488}
                    pixel
                    eager
                />
                </PlayHere>
                <div>
                    <p>
                        A 2D physics sandbox I'm making. Spawn ragdolls, build things, wire machines together, and see
                        what happens.
                    </p>
                    <p class="note">In development for Windows and Linux.</p>
                    <p><a href={site.playmatter}>more about playmatter →</a></p>
                </div>
            </div>
        </section>

        {
            posts.length > 0 && (
                <section aria-labelledby="writing-title">
                    <h2 class="label" id="writing-title">writing</h2>
                    <ul class="post-list">
                        {posts.map((post) => (
                            <PostRow post={post} level={3} compact />
                        ))}
                    </ul>
                    <p class="more">
                        <a href="/blog/">all posts →</a>
                    </p>
                </section>
            )
        }
    </div>
</Base>
