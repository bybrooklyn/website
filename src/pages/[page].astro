---
// A standalone long-form page from src/content/pages: /setup/, /about/.
// It gets the same treatment as a post (contents beside the text)
// but stays a main page, with the site's navigation.
// Styles for what written content can contain. They are loaded here, by the page, and not only by
// the components themselves: Astro's content security policy does not see styles that arrive from
// inside rendered Markdown, and would block them.
import "../styles/timeline.css";
import "../styles/diagram.css";
import "../styles/type.css";
import "../styles/minis.css";
import "../styles/terminal.css";
import type { GetStaticPaths } from "astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import "../styles/blog.css";
import Contents from "../components/Contents.astro";
import Base from "../layouts/Base.astro";
import { visible } from "../lib/drafts";

export const getStaticPaths = (async () => {
    const pages = await getCollection("pages", visible);
    return pages.map((page) => ({ params: { page: page.id }, props: { entry: page } }));
}) satisfies GetStaticPaths;

interface Props {
    entry: CollectionEntry<"pages">;
}

const { entry } = Astro.props;
const { title, summary, kicker, numbered, draft } = entry.data;
const { Content, headings } = await render(entry);
---

<Base {title} description={summary} unlisted={draft}>
    <article class:list={["post", { manual: numbered }]}>
        <header class="post-header">
            {
                (kicker || draft) && (
                    <p class="post-meta">
                        {kicker && <span>{kicker}</span>}
                        {draft && <span>draft</span>}
                    </p>
                )
            }
            <h1>{title}</h1>
            <p class="lede">{summary}</p>
        </header>
        <div class="post-body">
            <Contents {title} {headings} />
            <div class="prose">
                <Content />
            </div>
        </div>
    </article>
</Base>
