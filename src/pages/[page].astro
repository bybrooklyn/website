---
// A standalone long-form page from src/content/pages: /setup/, /about/.
// It gets the same treatment as a post (contents beside the text)
// but stays a main page, with the site's navigation.
import "../styles/content";
import type { GetStaticPaths } from "astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import "../styles/blog.css";
import "../styles/projects.css";
import Contents from "../components/Contents.astro";
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { visible } from "../lib/drafts";

export const getStaticPaths = (async () => {
    const pages = await getCollection("pages", visible);
    return pages.map((page) => ({ params: { page: page.id }, props: { entry: page } }));
}) satisfies GetStaticPaths;

interface Props {
    entry: CollectionEntry<"pages">;
}

const { entry } = Astro.props;
const { title, summary, kicker, numbered, draft } = entry.data;
const { Content, headings } = await render(entry);
---

<Base {title} description={summary} unlisted={draft}>
    <article class:list={["post", { manual: numbered }]}>
        <header class="post-header">
            {
                (kicker || draft) && (
                    <p class="post-meta">
                        {kicker && <span>{kicker}</span>}
                        {draft && <span>draft</span>}
                    </p>
                )
            }
            <h1>{title}</h1>
            <p class="lede">{summary}</p>
        </header>
        <div class="post-body">
            <Contents {title} {headings} />
            <div class="prose">
                {/* The about page opens with the plain facts about her: what to call her, where she is, how to reach her. */}
                {
                    entry.id === "about" && (
                        <dl class="facts">
                            <div>
                                <dt>pronouns</dt>
                                <dd>{site.pronouns}</dd>
                            </div>
                            <div>
                                <dt>where</dt>
                                <dd>{site.location}</dd>
                            </div>
                            <div>
                                <dt>time</dt>
                                <dd>{site.time}</dd>
                            </div>
                            <div>
                                <dt>reach me</dt>
                                <dd>
                                    <a href={`mailto:${site.email}`}>{site.email}</a>
                                </dd>
                            </div>
                        </dl>
                    )
                }
                <Content />
            </div>
        </div>
    </article>
</Base>
