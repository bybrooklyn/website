---
// mdQuire with Google Drive stood in for: the whole app as /mdquire/ has it, but Drive is kept in
// this page's memory and signing in is answered at once, so that the Drive place, its dialog and a
// document saved and opened again can be tried and photographed with no Google account. Nothing is
// sent anywhere and nothing outlives the page. Unlisted, and out of search and the sitemap.
import Document from "../layouts/Document.astro";
import Flags from "../components/Flags.astro";
import { site } from "../data/site";
import "../styles/quire.css";
import "../styles/quire-markdown.css";
import "../styles/quire-extras.css";
---

<Document title="mdQuire" description="Trying Google Drive in mdQuire without Google." unlisted bodyClass="quire-app" icon="/mdquire/icon.svg">
    <header class="quire-top">
        <div class="quire-top-in">
            <div class="quire-top-line">
                <nav class="quire-trail" aria-label="Where you are">
                    <div class="site-id">
                        <a class="site-name" href="/">{site.name.toLowerCase()}</a>
                        <Flags />
                    </div>
                    <span class="quire-stroke quire-word-stroke" aria-hidden="true">/</span>
                    <a class="quire-word" href="/mdquire-drive-try/" aria-label="mdQuire: all documents">mdQuire</a>
                    <span class="quire-stroke quire-name-stroke" aria-hidden="true">/</span>
                    <span class="quire-name-home"></span>
                </nav>
                <div class="quire-menus-home"></div>
                <div class="quire-status-home"></div>
            </div>
            <div class="quire-bar-home"></div>
        </div>
    </header>
    <main id="main" tabindex="-1">
        <div id="quire" class="quire-host"></div>
    </main>
</Document>

<script>
    import "../scripts/mdquire-drive-try";
</script>
