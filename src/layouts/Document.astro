---
// The <html> and <head> every page shares. Base.astro (main pages) and
// Opened.astro (a post or project, opened over the site) fill in the body.
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/prose.css";
import "../styles/opened.css";
import "../styles/motion.css";

import { Font, getImage } from "astro:assets";
import { nav, site } from "../data/site";
import transition from "../scripts/transition.js?raw";
import { theme, type AccentName } from "../data/theme";
import { hex, themeStyle } from "../lib/color";
import { hasPosts } from "../lib/posts";

interface Props {
    title?: string;
    description?: string;
    accent?: AccentName;
    /** Open Graph type; posts are articles. */
    type?: "website" | "article";
    /** Keep the page out of search results. */
    unlisted?: boolean;
    bodyClass?: string;
    /** The picture used when the page is shared. The Playmatter one if left out. */
    image?: ImageMetadata;
}

const { title, description = site.description, accent, type = "website", unlisted = false, bodyClass, image } = Astro.props;

const pageTitle = title ? `${title} · ${site.name.toLowerCase()}` : site.name.toLowerCase();
const canonical = new URL(Astro.url.pathname, Astro.site);
const shared = image
    ? await getImage({ src: image, width: 1200, format: "png" })
    : { src: "/assets/playmatter-share.png", attributes: { width: 1200, height: 610 } };
const sharedUrl = new URL(shared.src, Astro.site);
const posts = await hasPosts();
/** The main pages in nav order, home first: the page transition moves along this. */
const order = ["/", ...nav.map((item) => item.href)];
---

<!doctype html>
<html lang="en" style={themeStyle(accent)} data-order={order.join(" ")}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        {unlisted && <meta name="robots" content="noindex" />}
        <meta name="color-scheme" content="dark" />
        {/* Only the upright Torrens Serif is fetched ahead of time: every page starts with it. */}
        <Font cssVariable="--font-torrens" preload={[{ style: "normal" }]} />
        <Font cssVariable="--font-mono" />
        {/* There is no icon; this stops browsers asking for one and logging a miss. */}
        <link rel="icon" href="data:," />
        <meta name="theme-color" content={hex(theme.ground)} />
        {posts && <link rel="alternate" type="application/rss+xml" title={`${site.name}'s blog`} href="/rss.xml" />}
        <meta property="og:title" content={title ?? site.name} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content={type} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={sharedUrl} />
        <meta property="og:image:width" content={String(shared.attributes.width)} />
        <meta property="og:image:height" content={String(shared.attributes.height)} />
        <meta name="twitter:card" content="summary_large_image" />
        <script is:inline set:html={transition} />
        <slot name="head" />
    </head>
    <body class={bodyClass}>
        <a class="skip" href="#main">Skip to the page</a>
        <slot />
    </body>
</html>
