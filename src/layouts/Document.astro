---
// The <html> and <head> every page shares. Base.astro (main pages) and
// Opened.astro (a post or project, opened over the site) fill in the body.
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/prose.css";
import "../styles/opened.css";
import "../styles/motion.css";
import "../styles/viewer.css";

import { Font, getImage } from "astro:assets";
import { nav, site } from "../data/site";
import transition from "../scripts/transition.js?raw";
import { accents, theme, type AccentName } from "../data/theme";
import { hex, themeStyle } from "../lib/color";
import { hasPosts } from "../lib/posts";
import { openedPages } from "../lib/projects";
import { sharePicture, type Fact } from "../lib/share";

interface Props {
    title?: string;
    description?: string;
    accent?: AccentName;
    /** Open Graph type; posts are articles. */
    type?: "website" | "article";
    /** Keep the page out of search results. */
    unlisted?: boolean;
    bodyClass?: string;
    /** The picture used when the page is shared. The card with the site's name if left out. */
    image?: ImageMetadata;
    imageAlt?: string;
    /** Up to two facts for the link preview, such as a project's language and status. */
    facts?: Fact[];
    /** When a post was published, and its tags. */
    published?: Date;
    tags?: string[];
}

const { title, description = site.description, accent, type = "website", unlisted = false, bodyClass, image, imageAlt, facts = [], published, tags = [] } = Astro.props;

const pageTitle = title ? `${title} · ${site.name.toLowerCase()}` : site.name.toLowerCase();
const canonical = new URL(Astro.url.pathname, Astro.site);
const picture = image ?? sharePicture("site");
const shared = picture ? await getImage({ src: picture, width: 1200, format: "png" }) : undefined;
const sharedAlt = imageAlt ?? (image ? `${title}, on ${site.name}'s website.` : `${site.name.toLowerCase()}.`);
// The file Discord reads for the line above the title: this page's own when it has facts.
const oembed = new URL(`/oembed/${facts.length > 0 ? Astro.url.pathname.replace(/^\/|\/$/g, "") : "site"}.json`, Astro.site);
const posts = await hasPosts();
/** The main pages in nav order, home first: the page transition moves along this. */
const order = ["/", ...nav.map((item) => item.href)];
/** Pages that open like a project although they are not under /projects/, such as /spectrum/. */
const opened = await openedPages();
---

<!doctype html>
<html lang="en" style={themeStyle(accent)} data-order={order.join(" ")} data-opened={opened.join(" ")}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        {unlisted && <meta name="robots" content="noindex" />}
        <meta name="color-scheme" content="dark" />
        {/* Only the upright Torrens Serif is fetched ahead of time: every page starts with it. */}
        <Font cssVariable="--font-torrens" preload={[{ style: "normal" }]} />
        <Font cssVariable="--font-mono" />
        {/* There is no icon; this stops browsers asking for one and logging a miss. */}
        <link rel="icon" href="data:," />
        {/* A browser takes the first that fits, so its own bars stay the page's color. The last, plain one is for a link preview's stripe. */}
        <meta name="theme-color" media="(prefers-color-scheme: dark)" content={hex(theme.ground)} />
        <meta name="theme-color" media="(prefers-color-scheme: light)" content={hex(theme.ground)} />
        <meta name="theme-color" content={hex(accents[accent ?? "violet"])} />
        {posts && <link rel="alternate" type="application/rss+xml" title={`${site.name}'s blog`} href="/rss.xml" />}
        <meta property="og:title" content={title ?? site.name} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content={type} />
        <meta property="og:url" content={canonical} />
        <meta property="og:site_name" content={site.name.toLowerCase()} />
        {
            shared && (
                <>
                    <meta property="og:image" content={new URL(shared.src, Astro.site)} />
                    <meta property="og:image:width" content={String(shared.attributes.width)} />
                    <meta property="og:image:height" content={String(shared.attributes.height)} />
                    <meta property="og:image:alt" content={sharedAlt} />
                    <meta name="twitter:card" content="summary_large_image" />
                </>
            )
        }
        {published && <meta property="article:published_time" content={published.toISOString()} />}
        {tags.map((tag) => <meta property="article:tag" content={tag} />)}
        {
            facts.slice(0, 2).map(([label, value], index) => (
                <>
                    <meta name={`twitter:label${index + 1}`} content={label} />
                    <meta name={`twitter:data${index + 1}`} content={value} />
                </>
            ))
        }
        <link rel="alternate" type="application/json+oembed" href={oembed} title={title ?? site.name} />
        <script is:inline set:html={transition} />
        <slot name="head" />
    </head>
    <body class={bodyClass}>
        <a class="skip" href="#main">Skip to the page</a>
        <slot />
        <button type="button" class="to-top" aria-label="Back to the top" tabindex="-1">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 10l5-5 5 5"></path></svg>
        </button>
        <script>
            import "../scripts/viewer";

            // Back to the top: shown once a long page has been scrolled about a screen, on whatever it is that scrolls.
            const up = document.querySelector<HTMLButtonElement>(".to-top");
            const panel = document.querySelector<HTMLElement>(".opened-panel");
            const scroller = panel ?? document.documentElement;
            if (up) {
                const look = () => {
                    const shown = scroller.scrollTop > innerHeight * 0.9;
                    up.classList.toggle("shown", shown);
                    up.tabIndex = shown ? 0 : -1;
                };
                (panel ?? window).addEventListener("scroll", look, { passive: true });
                up.addEventListener("click", () => {
                    scroller.scrollTo({ top: 0, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth" });
                    (panel ?? document.body).focus({ preventScroll: true });
                });
                look();
            }
        </script>
    </body>
</html>
