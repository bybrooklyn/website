---
import "../styles/resume.css";
import Base from "./Base.astro";
import { render } from "astro:content";
import { site } from "../data/site";
import { existsSync } from "node:fs";
import { resumePdf, type Resume } from "../lib/resume";

interface Props {
    resume: Resume;
}

const { resume } = Astro.props;
const { Content } = await render(resume);
const plain = (url: string) => url.replace(/^https?:\/\//, "");

// The PDF is only on the site once the resume is published and printed
// (`bun run resume:pdf`). Until then the button prints this page, which the
// print styles lay out as the same single sheet.
const hasPdf = existsSync(new URL(`../../public${resumePdf}`, import.meta.url));
---

<Base title="resume" description={resume.data.summary} unlisted={resume.data.draft}>
    <article class="resume">
        <header class="resume-head">
            <div>
                <h1>{site.name} {site.lastName}</h1>
                <p class="resume-contact">
                    <span>{site.pronouns}</span>
                    <span>{site.location}</span>
                    <a href={`mailto:${site.email}`}>{site.email}</a>
                    <a href={site.github}>{plain(site.github)}</a>
                    <a href={Astro.site}>{Astro.site?.host}</a>
                </p>
            </div>
            {
                hasPdf ? (
                    <a class="resume-pdf" href={resumePdf} download>download pdf</a>
                ) : (
                    <button class="resume-pdf" type="button" data-print>save as pdf</button>
                )
            }
        </header>
        <p class="resume-summary">{resume.data.summary}</p>
        <div class="resume-columns">
            <Content />
        </div>
    </article>
</Base>

<script>
    document.querySelector("[data-print]")?.addEventListener("click", () => window.print());
</script>
