---
// A post or project. A strip on the left links back to its list, and the
// page scrolls in a panel beside it. On phones the strip becomes a floating
// back button.
import Document from "./Document.astro";
import Flags from "../components/Flags.astro";
import { site } from "../data/site";
import type { AccentName } from "../data/theme";

interface Props {
    title: string;
    description: string;
    accent?: AccentName;
    type?: "website" | "article";
    /** The picture used when the page is shared. */
    image?: ImageMetadata;
    unlisted?: boolean;
    /** The list this was opened from. */
    back: { href: string; label: string };
}

const { back, title, ...document } = Astro.props;
---

<Document {title} {...document} bodyClass="opened">
    <slot name="head" slot="head" />
    <a class="strip" href={back.href} aria-label={`Back to ${back.label}`}>
        <span class="strip-button" aria-hidden="true">
            <svg viewBox="0 0 16 26" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12.5 3 3.5 13l9 10"></path>
            </svg>
        </span>
    </a>
    <div class="opened-panel" tabindex="-1">
        <header class="opened-top">
            <div class="site-id">
                <a class="site-name" href="/">{site.name.toLowerCase()}</a>
                <Flags />
            </div>
            <nav class="trail" aria-label="Where you are">
                <a href={back.href}>{back.label}</a>
                <span aria-hidden="true">/</span>
                <span aria-current="page">{title}</span>
            </nav>
        </header>
        <main id="main">
            <slot />
        </main>
    </div>
    <script>
        // The panel scrolls, not the page, so give it the keyboard: without
        // this, Page Down, Space and the arrow keys do nothing until a click.
        document.querySelector<HTMLElement>(".opened-panel")?.focus({ preventScroll: true });

        // Back goes to wherever this was opened from. A post opened from the home
        // page goes back to the home page, not to the blog's list. Moving between
        // opened pages keeps the place first come from.
        const strip = document.querySelector<HTMLAnchorElement>(".strip");
        try {
            const from = document.referrer ? new URL(document.referrer) : undefined;
            const opened = (path: string) => /^\/(blog|projects|minis)\/[^/]+\/$/.test(path);
            if (from && from.origin === location.origin && !opened(from.pathname)) sessionStorage.setItem("opened-from", from.pathname);
            else if (!from || from.origin !== location.origin) sessionStorage.removeItem("opened-from");
            const place = sessionStorage.getItem("opened-from");
            if (strip && place && place !== new URL(strip.href).pathname) {
                strip.href = place;
                strip.setAttribute("aria-label", "Back");
            }
        } catch {
            // No storage: back goes to the list, as written.
        }
    </script>
</Document>
