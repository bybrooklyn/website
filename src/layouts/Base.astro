---
import Document from "./Document.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { AccentName } from "../data/theme";

interface Props {
    title?: string;
    description?: string;
    accent?: AccentName;
    type?: "website" | "article";
    unlisted?: boolean;
    image?: ImageMetadata;
}
---

<Document {...Astro.props}>
    <Header />
    <main id="main">
        <slot />
    </main>
    <Footer />
</Document>
