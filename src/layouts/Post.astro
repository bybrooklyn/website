---
// Styles for what written content can contain. They are loaded here, by the page, and not only by
// the components themselves: Astro's content security policy does not see styles that arrive from
// inside rendered Markdown, and would block them.
import "../styles/timeline.css";
import "../styles/diagram.css";
import "../styles/type.css";
import PrevNext from "../components/PrevNext.astro";
import Picture from "../components/Picture.astro";
import type { MarkdownHeading } from "astro";
import "../styles/blog.css";
import Opened from "./Opened.astro";
import Contents from "../components/Contents.astro";
import { formatDate, readingTime, type Post } from "../lib/posts";

interface Props {
    post: Post;
    headings: MarkdownHeading[];
    newer?: Post;
    older?: Post;
}

const { post, headings, newer, older } = Astro.props;
const { title, summary, date, accent, draft, cover, coverAlt, tags } = post.data;
---

<Opened {title} description={summary} {accent} type="article" unlisted={draft} image={cover} back={{ href: "/blog/", label: "blog" }}>
    <article class="post">
        <header class="post-header">
            <p class="post-meta">
                <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
                <span>{readingTime(post)}</span>
                {draft && <span>draft</span>}
            </p>
            <h1>{title}</h1>
            <p class="lede">{summary}</p>
            {
                tags.length > 0 && (
                    <ul class="tags" aria-label="Tags">
                        {tags.map((tag) => (
                            <li>{tag}</li>
                        ))}
                    </ul>
                )
            }
        </header>

        {cover && <Picture class="post-cover" src={cover} alt={coverAlt ?? ""} widths={[640, 960, 1440]} sizes="(min-width: 60rem) 44rem, 100vw" loading="eager" fetchpriority="high" />}

        <div class="post-body">
            <Contents {title} {headings} />
            <div class="prose">
                <slot />
            </div>
        </div>

        <PrevNext
            label="More posts"
            previous={older && { href: `/blog/${older.id}/`, note: "older", title: older.data.title }}
            next={newer ? { href: `/blog/${newer.id}/`, note: "newer", title: newer.data.title } : { href: "/blog/", note: "that's the latest.", title: "all posts" }}
        />
    </article>
</Opened>
