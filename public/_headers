# Cloudflare Pages response headers.
#
# The content security policy for scripts, styles and everything else is in a
# <meta> on each page, written by Astro at build time (astro.config.ts). Only
# frame-ancestors is here, because a <meta> cannot set it.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

# Built files carry a hash in their name, so they never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The clip, poster and share image: a day, then check again.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Photographs keep their name for good, so a week is safe.
/photos/*
  Cache-Control: public, max-age=604800

# The Walker mini's engine keeps its name when it is rebuilt: a day, then check again.
/wasm/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/resume/*.pdf
  Cache-Control: public, max-age=3600
