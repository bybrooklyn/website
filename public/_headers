# Cloudflare Pages response headers.
#
# The content security policy for scripts, styles and everything else is in a
# <meta> on each page, written by Astro at build time (astro.config.ts). Only
# frame-ancestors is here, because a <meta> cannot set it.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

# mdQuire's dictation listens through the microphone, which the rule above switches off for the
# whole site. These pages take that header back and send one that allows the microphone to the
# page itself and to nothing embedded in it.
/mdquire/*
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=(), interest-cohort=()

/mdquire-dictation/*
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=(), interest-cohort=()

# mdQuire's pages are cross-origin isolated, so that the speech model can run on several threads
# (SharedArrayBuffer needs it). Only these two paths: nothing else on the site is isolated.
# "require-corp" rather than "credentialless" because Safari does not know the second and would
# stay on one thread. It costs these pages nothing the page policy did not already take: images,
# scripts, styles and fonts may only come from the site itself (the <meta> policy), and the model
# and the GitHub store are fetched with CORS, which both answer.
/mdquire/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

/mdquire-dictation/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# A worker's script must carry the embedder policy of the page that starts it, or the browser
# refuses it: the engine worker lives in /_astro/ and ONNX Runtime's thread workers in /ort/.
# On a script this header changes nothing for any other page that uses the file.
# Built files carry a hash in their name, so they never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Embedder-Policy: require-corp

# ONNX Runtime's files for dictation keep their names when the library is updated: a day, then check again.
/ort/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Cross-Origin-Embedder-Policy: require-corp

# The clip, poster and share image: a day, then check again.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Photographs keep their name for good, so a week is safe.
/photos/*
  Cache-Control: public, max-age=604800

# The Walker mini's engine keeps its name when it is rebuilt: a day, then check again.
/wasm/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/resume/*.pdf
  Cache-Control: public, max-age=3600
